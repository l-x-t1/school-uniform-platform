# 页面标题
VUE_APP_TITLE = 石家庄市校服管理平台

# 开发环境配置
ENV = 'development'

# 石家庄市校服管理平台/开发环境
VUE_APP_BASE_API = '/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 图片访问地址
VUE_APP_IMAGE_BASE_API = 'http://127.0.0.1:9300'
# VITE_APP_KKFILE1 ='http://127.0.0.1:9000'
VUE_APP_KKFILE2 ="http://127.0.0.1:8012/onlinePreview?url="

VUE_APP_QR_CODE_URL = "http://localhost/notice"

# 手机端 H5 基础地址（扫码访问时会在其后拼接 deptId 查询参数）
VUE_APP_MOBILE_H5_URL = "http://localhost/h5"

