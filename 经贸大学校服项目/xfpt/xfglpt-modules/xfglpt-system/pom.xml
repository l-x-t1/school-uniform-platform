<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.xfgl</groupId>
    <artifactId>xfgl-modules</artifactId>
    <version>3.6.5</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>xfgl-modules-system</artifactId>
  <properties>
    <hebca.lib.dir>${project.basedir}/src/main/resources/lib</hebca.lib.dir>
  </properties>
  <description>
        xfglpt-modules-system系统模块
    </description>
  <dependencies>
    <!-- SpringCloud Alibaba Nacos -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <!-- SpringCloud Alibaba Nacos Config -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
    </dependency>
    <!-- SpringCloud Alibaba Sentinel -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
    </dependency>
    <!-- SpringBoot Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Mysql Connector -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>
    <!-- RuoYi Common DataSource -->
    <dependency>
      <groupId>com.xfgl</groupId>
      <artifactId>xfgl-common-datasource</artifactId>
    </dependency>
    <!-- RuoYi Common DataScope -->
    <dependency>
      <groupId>com.xfgl</groupId>
      <artifactId>xfgl-common-datascope</artifactId>
    </dependency>
    <!-- RuoYi Common Log -->
    <dependency>
      <groupId>com.xfgl</groupId>
      <artifactId>xfgl-common-log</artifactId>
    </dependency>
    <!-- RuoYi Common Swagger -->
    <dependency>
      <groupId>com.xfgl</groupId>
      <artifactId>xfgl-common-swagger</artifactId>
    </dependency>
    <dependency>
      <groupId>com.xfgl</groupId>
      <artifactId>xfgl-common-sensitive</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.promeg</groupId>
      <artifactId>tinypinyin</artifactId>
      <version>2.0.3</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 河北CA相关依赖 -->
    <dependency>
      <groupId>com.hebca</groupId>
      <artifactId>bcy-base</artifactId>
      <version>148</version>
      <scope>system</scope>
      <systemPath>${hebca.lib.dir}/bcy-base-148.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.hebca</groupId>
      <artifactId>svs-client-shade</artifactId>
      <version>3.3.0</version>
      <scope>system</scope>
      <systemPath>${hebca.lib.dir}/svs-client-shade-3.3.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.hebca</groupId>
      <artifactId>bcy-tsp</artifactId>
      <version>1.0.0</version>
      <scope>system</scope>
      <systemPath>${hebca.lib.dir}/bcy-tsp.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.hebca</groupId>
      <artifactId>hebcacloud-sdk</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${hebca.lib.dir}/hebcacloud-sdk-0.0.1-SNAPSHOT.jar</systemPath>
    </dependency>
    <!-- JSON依赖 -->
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20171018</version>
      <scope>system</scope>
      <systemPath>${hebca.lib.dir}/org.json-20171018.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <includeSystemScope>true</includeSystemScope>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
