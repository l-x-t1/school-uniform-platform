<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.system.mapper.XfptCategoryNoticeMapper">

    <resultMap type="XfptCategoryNotice" id="XfptCategoryNoticeResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="sort"    column="sort"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="parentId"    column="parent_id"    />
        <result property="bs"    column="bs"    />
        <result property="isCoverImage"    column="is_cover_image"    />
    </resultMap>

    <sql id="selectXfptCategoryNoticeVo">
        select is_cover_image,bs,id, name, status, create_by, update_time, update_by, create_time, sort, del_flag, cast(parent_id as unsigned) as parent_id from xfpt_category_notice
    </sql>

    <select id="selectXfptCategoryNoticeList" parameterType="XfptCategoryNotice" resultMap="XfptCategoryNoticeResult">
        <include refid="selectXfptCategoryNoticeVo"/>
        <include refid="search"/>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="parentId != null  and parentId != ''"> and parent_id = #{parentId}</if>
            order by create_time desc
    </select>

    <select id="selectXfptCategoryNoticeList2" parameterType="XfptCategoryNotice" resultMap="XfptCategoryNoticeResult">
        <include refid="selectXfptCategoryNoticeVo"/>
        <include refid="search"/>
        <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        <if test="status != null  and status != ''"> and status = #{status}</if>
        <if test="sort != null "> and sort = #{sort}</if>
        <if test="parentId != null  and parentId != ''"> and parent_id = #{parentId}</if>
        and STATUS='1' and bs != 'CGGG'
    </select>


    <select id="selectXfptCategoryNoticeById" parameterType="Long" resultMap="XfptCategoryNoticeResult">
        <include refid="selectXfptCategoryNoticeVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptCategoryNotice" parameterType="XfptCategoryNotice" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_category_notice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="sort != null">sort,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="parentId != null">parent_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="sort != null">#{sort},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="parentId != null">#{parentId},</if>
         </trim>
    </insert>

    <update id="updateXfptCategoryNotice" parameterType="XfptCategoryNotice">
        update xfpt_category_notice
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptCategoryNoticeById" parameterType="Long">
        delete from xfpt_category_notice where id = #{id}
    </delete>

    <delete id="deleteXfptCategoryNoticeByIds" parameterType="String">
        delete from xfpt_category_notice where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
