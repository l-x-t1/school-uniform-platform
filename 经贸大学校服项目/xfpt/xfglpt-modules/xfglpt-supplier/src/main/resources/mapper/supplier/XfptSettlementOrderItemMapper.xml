<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.supplier.mapper.XfptSettlementOrderItemMapper">

    <resultMap type="XfptSettlementOrderItem" id="XfptSettlementOrderItemResult">
        <result property="id"    column="id"    />
        <result property="settlementId"    column="settlement_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="financeFlowId"    column="finance_flow_id"    />
        <result property="businessType"    column="business_type"    />
        <result property="settlementAmount"    column="settlement_amount"    />
        <result property="sourceTime"    column="source_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptSettlementOrderItemVo">
        select id, settlement_id, order_id, order_no, finance_flow_id, business_type, settlement_amount, source_time, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_settlement_order_item
    </sql>

    <select id="selectXfptSettlementOrderItemList" parameterType="XfptSettlementOrderItem" resultMap="XfptSettlementOrderItemResult">
        <include refid="selectXfptSettlementOrderItemVo"/>
        <include refid="search"/>
            <if test="settlementId != null "> and settlement_id = #{settlementId}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="financeFlowId != null "> and finance_flow_id = #{financeFlowId}</if>
            <if test="businessType != null  and businessType != ''"> and business_type = #{businessType}</if>
            <if test="settlementAmount != null "> and settlement_amount = #{settlementAmount}</if>
            <if test="sourceTime != null "> and source_time = #{sourceTime}</if>

    </select>

    <select id="selectXfptSettlementOrderItemById" parameterType="Long" resultMap="XfptSettlementOrderItemResult">
        <include refid="selectXfptSettlementOrderItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptSettlementOrderItem" parameterType="XfptSettlementOrderItem" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_settlement_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="settlementId != null">settlement_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="financeFlowId != null">finance_flow_id,</if>
            <if test="businessType != null and businessType != ''">business_type,</if>
            <if test="settlementAmount != null">settlement_amount,</if>
            <if test="sourceTime != null">source_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="settlementId != null">#{settlementId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="financeFlowId != null">#{financeFlowId},</if>
            <if test="businessType != null and businessType != ''">#{businessType},</if>
            <if test="settlementAmount != null">#{settlementAmount},</if>
            <if test="sourceTime != null">#{sourceTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptSettlementOrderItem" parameterType="XfptSettlementOrderItem">
        update xfpt_settlement_order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="settlementId != null">settlement_id = #{settlementId},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="financeFlowId != null">finance_flow_id = #{financeFlowId},</if>
            <if test="businessType != null and businessType != ''">business_type = #{businessType},</if>
            <if test="settlementAmount != null">settlement_amount = #{settlementAmount},</if>
            <if test="sourceTime != null">source_time = #{sourceTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptSettlementOrderItemById" parameterType="Long">
        delete from xfpt_settlement_order_item where id = #{id}
    </delete>

    <delete id="deleteXfptSettlementOrderItemByIds" parameterType="String">
        delete from xfpt_settlement_order_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
