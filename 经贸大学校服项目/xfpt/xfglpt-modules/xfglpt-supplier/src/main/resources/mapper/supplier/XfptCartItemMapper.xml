<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.supplier.mapper.XfptCartItemMapper">

    <resultMap type="XfptCartItem" id="XfptCartItemResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="sizeId"    column="size_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="sizeName"    column="size_name"    />
        <result property="mainImage"    column="main_image"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="buyNum"    column="buy_num"    />
        <result property="checkedFlag"    column="checked_flag"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectXfptCartItemVo">
        select id, user_id, student_id, goods_id, size_id, goods_name, size_name, main_image, unit_price, buy_num, checked_flag, remark, del_flag, create_by, create_time, update_by, update_time from xfpt_cart_item
    </sql>

    <select id="selectXfptCartItemList" parameterType="XfptCartItem" resultMap="XfptCartItemResult">
        <include refid="selectXfptCartItemVo"/>
        <include refid="search"/>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="studentId != null "> and student_id = #{studentId}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="sizeId != null "> and size_id = #{sizeId}</if>
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="sizeName != null  and sizeName != ''"> and size_name like concat('%', #{sizeName}, '%')</if>
            <if test="mainImage != null  and mainImage != ''"> and main_image = #{mainImage}</if>
            <if test="unitPrice != null "> and unit_price = #{unitPrice}</if>
            <if test="buyNum != null  and buyNum != ''"> and buy_num = #{buyNum}</if>
            <if test="checkedFlag != null  and checkedFlag != ''"> and checked_flag = #{checkedFlag}</if>

    </select>

    <select id="selectXfptCartItemById" parameterType="Long" resultMap="XfptCartItemResult">
        <include refid="selectXfptCartItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptCartItem" parameterType="XfptCartItem" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_cart_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="studentId != null">student_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="sizeId != null">size_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="sizeName != null and sizeName != ''">size_name,</if>
            <if test="mainImage != null">main_image,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="buyNum != null and buyNum != ''">buy_num,</if>
            <if test="checkedFlag != null and checkedFlag != ''">checked_flag,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sizeId != null">#{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="sizeName != null and sizeName != ''">#{sizeName},</if>
            <if test="mainImage != null">#{mainImage},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="buyNum != null and buyNum != ''">#{buyNum},</if>
            <if test="checkedFlag != null and checkedFlag != ''">#{checkedFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateXfptCartItem" parameterType="XfptCartItem">
        update xfpt_cart_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sizeId != null">size_id = #{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="sizeName != null and sizeName != ''">size_name = #{sizeName},</if>
            <if test="mainImage != null">main_image = #{mainImage},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="buyNum != null and buyNum != ''">buy_num = #{buyNum},</if>
            <if test="checkedFlag != null and checkedFlag != ''">checked_flag = #{checkedFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptCartItemById" parameterType="Long">
        delete from xfpt_cart_item where id = #{id}
    </delete>

    <delete id="deleteXfptCartItemByIds" parameterType="String">
        delete from xfpt_cart_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
