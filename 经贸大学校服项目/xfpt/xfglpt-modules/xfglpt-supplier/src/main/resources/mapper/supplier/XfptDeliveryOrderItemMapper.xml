            <if test="signNum != null">#{signNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="ancestors != null">#{ancestors},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateXfptDeliveryOrderItem" parameterType="XfptDeliveryOrderItem">
        update xfpt_delivery_order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="deliveryId != null">delivery_id = #{deliveryId},</if>
            <if test="orderItemId != null">order_item_id = #{orderItemId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sizeId != null">size_id = #{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="sizeName != null">size_name = #{sizeName},</if>
            <if test="deliveryNum != null and deliveryNum != ''">delivery_num = #{deliveryNum},</if>
            <if test="signNum != null">sign_num = #{signNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
