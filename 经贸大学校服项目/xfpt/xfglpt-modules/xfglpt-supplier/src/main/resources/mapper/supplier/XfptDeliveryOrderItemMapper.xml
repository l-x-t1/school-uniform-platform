    <sql id="selectXfptDeliveryOrderItemVo">
        select id, delivery_id, order_item_id, goods_id, size_id, goods_name, size_name, delivery_num, sign_num, status, dept_id, ancestors, remark, del_flag, create_by, create_time, update_by, update_time from xfpt_delivery_order_item
    </sql>

    <select id="selectXfptDeliveryOrderItemList" parameterType="XfptDeliveryOrderItem" resultMap="XfptDeliveryOrderItemResult">
        <include refid="selectXfptDeliveryOrderItemVo"/>
        <include refid="search"/>
            <if test="deliveryId != null "> and delivery_id = #{deliveryId}</if>
            <if test="orderItemId != null "> and order_item_id = #{orderItemId}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="sizeId != null "> and size_id = #{sizeId}</if>
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="sizeName != null  and sizeName != ''"> and size_name like concat('%', #{sizeName}, '%')</if>
            <if test="deliveryNum != null  and deliveryNum != ''"> and delivery_num = #{deliveryNum}</if>
            <if test="signNum != null  and signNum != ''"> and sign_num = #{signNum}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="ancestors != null  and ancestors != ''"> and ancestors = #{ancestors}</if>

    </select>

    <select id="selectXfptDeliveryOrderItemById" parameterType="Long" resultMap="XfptDeliveryOrderItemResult">
        <include refid="selectXfptDeliveryOrderItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptDeliveryOrderItem" parameterType="XfptDeliveryOrderItem" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_delivery_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryId != null">delivery_id,</if>
            <if test="orderItemId != null">order_item_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="sizeId != null">size_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="sizeName != null">size_name,</if>
            <if test="deliveryNum != null and deliveryNum != ''">delivery_num,</if>
            <if test="signNum != null">sign_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryId != null">#{deliveryId},</if>
            <if test="orderItemId != null">#{orderItemId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sizeId != null">#{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="sizeName != null">#{sizeName},</if>
