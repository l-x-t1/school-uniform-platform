    </update>

    <delete id="deleteXfptDeliveryOrderItemById" parameterType="Long">
        delete from xfpt_delivery_order_item where id = #{id}
    </delete>

    <delete id="deleteXfptDeliveryOrderItemByIds" parameterType="String">
        delete from xfpt_delivery_order_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
