<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptBuyGradeClassMapper">

    <resultMap type="com.xfgl.school.domain.XfptBuyGradeClass" id="XfptBuyGradeClassResult">
        <result property="id" column="id"/>
        <result property="gradeClassId" column="grade_class_id"/>
        <result property="gradeClassName" column="grade_class_name"/>
        <result property="amount" column="amount"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="category" column="category"/>
        <result property="pid" column="pid"/>
        <result property="parentId" column="parent_id"/>
        
    </resultMap>

    <sql id="selectXfptBuyGradeClassVo">
        select id,
               grade_class_id,
               grade_class_name,
               amount,
               create_time,
               create_by,
               update_by,
               update_time,
               remark,
               del_flag,
               category,
               pid,
               parent_id
        from xfpt_buy_grade_class
    </sql>

    <sql id="search">
        where del_flag = 0
    </sql>

    <select id="selectXfptBuyGradeClassList" parameterType="com.xfgl.school.domain.XfptBuyGradeClass"
            resultMap="XfptBuyGradeClassResult">
        <include refid="selectXfptBuyGradeClassVo"/>
        <include refid="search"/>
        <if test="gradeClassId != null ">and grade_class_id = #{gradeClassId}</if>
        <if test="gradeClassName != null  and gradeClassName != ''">and grade_class_name like concat('%',
            #{gradeClassName}, '%')
        </if>
        <if test="amount != null ">and amount = #{amount}</if>
        <if test="category != null ">and category = #{category}</if>
        <if test="pid != null ">and pid = #{pid}</if>
        <if test="parentId != null ">and parent_id = #{parentId}</if>
        
    </select>

    <select id="selectXfptBuyGradeClassById" parameterType="Long" resultMap="XfptBuyGradeClassResult">
        <include refid="selectXfptBuyGradeClassVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptBuyGradeClass" parameterType="com.xfgl.school.domain.XfptBuyGradeClass"
            useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_buy_grade_class
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gradeClassId != null">grade_class_id,</if>
            <if test="gradeClassName != null">grade_class_name,</if>
            <if test="amount != null">amount,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            <if test="category != null">category,</if>
            <if test="pid != null">pid,</if>
            <if test="parentId != null">parent_id,</if>
            
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gradeClassId != null">#{gradeClassId},</if>
            <if test="gradeClassName != null">#{gradeClassName},</if>
            <if test="amount != null">#{amount},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            <if test="category != null">#{category},</if>
            <if test="pid != null">#{pid},</if>
            <if test="parentId != null">#{parentId},</if>
            
        </trim>
    </insert>

    <update id="updateXfptBuyGradeClass" parameterType="com.xfgl.school.domain.XfptBuyGradeClass">
        update xfpt_buy_grade_class
        <trim prefix="SET" suffixOverrides=",">
            <if test="gradeClassId != null">grade_class_id = #{gradeClassId},</if>
            <if test="gradeClassName != null">grade_class_name = #{gradeClassName},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptBuyGradeClassById" parameterType="Long">
        delete
        from xfpt_buy_grade_class
        where id = #{id}
    </delete>

    <delete id="deleteXfptBuyGradeClass" parameterType="com.xfgl.school.domain.XfptBuyGradeClass">
        delete from xfpt_buy_grade_class
        where category = #{category}
        <if test="pid != null">
            and pid = #{pid}
        </if>
        <if test="pidList != null and pidList.size() > 0">
            and pid in
            <foreach collection="pidList" item="pidCurr" open="(" separator="," close=")">
                #{pidCurr}
            </foreach>
        </if>
    </delete>

    <delete id="deleteXfptBuyGradeClassByIds" parameterType="String">
        delete from xfpt_buy_grade_class where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
        
    </delete>

    <delete id="physicDeleteDataWithGradeClassIdList">
        delete from xfpt_buy_grade_class where pid = #{pid} and category = #{category}
        <if test="gradeClassIdList != null and gradeClassIdList.size() > 0">
            and grade_class_id  in
            <foreach collection="gradeClassIdList" item="gradeClassIdCurr" open="(" separator="," close=")">
                #{gradeClassIdCurr}
            </foreach>
        </if>
    </delete>
</mapper>
