<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptOrgReportDiscloseMapper">

    <resultMap type="com.xfgl.school.domain.XfptOrgReportDisclose" id="XfptOrgReportDiscloseResult">
        <result property="id" column="id"/>
        <result property="teamMeetingId" column="team_meeting_id"/>
        <result property="title" column="title"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="total" column="total"/>
        <result property="jzxsDb" column="jzxs_db"/>
        <result property="jzxsZb" column="jzxs_zb"/>
        <result property="deptId" column="dept_id"/>
        <result property="ancestors" column="ancestors"/>
        <result property="file" column="file"/>
    </resultMap>

    <sql id="selectXfptOrgReportDiscloseVo">
        select id,
               file,
               team_meeting_id,
               title,
               create_by,
               create_time,
               update_by,
               update_time,
               remark,
               del_flag,
               total,
               jzxs_db,
               jzxs_zb,
               dept_id,
               ancestors
        from xfpt_org_report_disclose
    </sql>

    <select id="selectXfptOrgReportDiscloseList" parameterType="com.xfgl.school.domain.XfptOrgReportDisclose"
            resultMap="XfptOrgReportDiscloseResult">
        <include refid="selectXfptOrgReportDiscloseVo"/>
        <include refid="search"/>
        <if test="id != null ">and id = #{id}</if>
        <if test="teamMeetingId != null ">and team_meeting_id = #{teamMeetingId}</if>
        <if test="title != null  and title != ''">and title like concat('%',#{title},'%')</if>
        <if test="total != null  and total != ''">and total = #{total}</if>
        <if test="jzxsDb != null  and jzxsDb != ''">and jzxs_db = #{jzxsDb}</if>
        <if test="jzxsZb != null  and jzxsZb != ''">and jzxs_zb = #{jzxsZb}</if>
        <if test="deptId != null">
            and (dept_id = #{deptId} or find_in_set(#{deptId},ancestors))
        </if>
        order by create_time desc
    </select>

    <select id="selectXfptOrgReportDiscloseById" resultMap="XfptOrgReportDiscloseResult">
        <include refid="selectXfptOrgReportDiscloseVo"/>
        where id = #{id}
    </select>

    <select id="selectXfptOrgReportDiscloseByTId" parameterType="Long" resultMap="XfptOrgReportDiscloseResult">
        <include refid="selectXfptOrgReportDiscloseVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptOrgReportDisclose" parameterType="com.xfgl.school.domain.XfptOrgReportDisclose"
            useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_org_report_disclose
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamMeetingId != null">team_meeting_id,</if>
            <if test="title != null">title,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="total != null">total,</if>
            <if test="jzxsDb != null">jzxs_db,</if>
            <if test="jzxsZb != null">jzxs_zb,</if>
            <if test="file != null">file,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamMeetingId != null">#{teamMeetingId},</if>
            <if test="title != null">#{title},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="total != null">#{total},</if>
            <if test="jzxsDb != null">#{jzxsDb},</if>
            <if test="jzxsZb != null">#{jzxsZb},</if>
            <if test="file != null">#{file},</if>
        </trim>
    </insert>

    <update id="updateXfptOrgReportDisclose" parameterType="com.xfgl.school.domain.XfptOrgReportDisclose">
        update xfpt_org_report_disclose
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamMeetingId != null">team_meeting_id = #{teamMeetingId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="total != null">total = #{total},</if>
            <if test="jzxsDb != null">jzxs_db = #{jzxsDb},</if>
            <if test="jzxsZb != null">jzxs_zb = #{jzxsZb},</if>
            <if test="file != null">file = #{file},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptOrgReportDiscloseByTId" parameterType="Long">
        delete
        from xfpt_org_report_disclose
        where id = #{id}
    </delete>

    <delete id="deleteXfptOrgReportDiscloseByTIds" parameterType="String">
        delete from xfpt_org_report_disclose where t_id in
        <foreach item="tId" collection="array" open="(" separator="," close=")">
            #{tId}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
