<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptCartItemMapper">

    <resultMap type="XfptCartItem" id="XfptCartItemResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="sizeId"    column="size_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="sizeName"    column="size_name"    />
        <result property="mainImage"    column="main_image"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="buyNum"    column="buy_num"    />
        <result property="checkedFlag"    column="checked_flag"    />
        <result property="orderType"    column="order_type"    />
        <result property="noticeId"    column="notice_id"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="schoolId"    column="school_id"    />
        <result property="schoolName"    column="school_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptCartItemVo">
        select c.id, c.user_id, c.student_id, c.goods_id, c.size_id, c.goods_name, c.size_name, c.main_image,
               c.unit_price, c.buy_num, c.checked_flag, c.order_type, c.notice_id,
               g.supplier_id, g.supplier_name, notice.school_id, notice.school_name,
               c.create_by, c.create_time, c.update_by, c.update_time, c.remark, c.del_flag
        from xfpt_cart_item c
        left join xfpt_goods g on g.id = c.goods_id and g.del_flag = '0'
        left join xfpt_group_notice notice on notice.id = c.notice_id and notice.del_flag = '0'
    </sql>

    <select id="selectXfptCartItemList" parameterType="XfptCartItem" resultMap="XfptCartItemResult">
        <include refid="selectXfptCartItemVo"/>
        <include refid="search"/>
            <if test="userId != null "> and c.user_id = #{userId}</if>
            <if test="studentId != null "> and c.student_id = #{studentId}</if>
            <if test="goodsId != null "> and c.goods_id = #{goodsId}</if>
            <if test="sizeId != null "> and c.size_id = #{sizeId}</if>
            <if test="goodsName != null  and goodsName != ''"> and c.goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="sizeName != null  and sizeName != ''"> and c.size_name like concat('%', #{sizeName}, '%')</if>
            <if test="mainImage != null  and mainImage != ''"> and c.main_image = #{mainImage}</if>
            <if test="unitPrice != null "> and c.unit_price = #{unitPrice}</if>
            <if test="buyNum != null "> and c.buy_num = #{buyNum}</if>
            <if test="checkedFlag != null  and checkedFlag != ''"> and c.checked_flag = #{checkedFlag}</if>
            <if test="orderType != null  and orderType != ''"> and c.order_type = #{orderType}</if>
            <if test="noticeId != null "> and c.notice_id = #{noticeId}</if>

    </select>

    <select id="selectXfptCartItemById" parameterType="Long" resultMap="XfptCartItemResult">
        <include refid="selectXfptCartItemVo"/>
        where c.id = #{id}
    </select>

    <insert id="insertXfptCartItem" parameterType="XfptCartItem" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_cart_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="studentId != null">student_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="sizeId != null">size_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="sizeName != null and sizeName != ''">size_name,</if>
            <if test="mainImage != null">main_image,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="buyNum != null">buy_num,</if>
            <if test="checkedFlag != null and checkedFlag != ''">checked_flag,</if>
            <if test="orderType != null and orderType != ''">order_type,</if>
            <if test="noticeId != null">notice_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="studentId != null">#{studentId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sizeId != null">#{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="sizeName != null and sizeName != ''">#{sizeName},</if>
            <if test="mainImage != null">#{mainImage},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="buyNum != null">#{buyNum},</if>
            <if test="checkedFlag != null and checkedFlag != ''">#{checkedFlag},</if>
            <if test="orderType != null and orderType != ''">#{orderType},</if>
            <if test="noticeId != null">#{noticeId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptCartItem" parameterType="XfptCartItem">
        update xfpt_cart_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sizeId != null">size_id = #{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="sizeName != null and sizeName != ''">size_name = #{sizeName},</if>
            <if test="mainImage != null">main_image = #{mainImage},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="buyNum != null">buy_num = #{buyNum},</if>
            <if test="checkedFlag != null and checkedFlag != ''">checked_flag = #{checkedFlag},</if>
            <if test="orderType != null and orderType != ''">order_type = #{orderType},</if>
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptCartItemById" parameterType="Long">
        delete from xfpt_cart_item where id = #{id}
    </delete>

    <delete id="deleteXfptCartItemByIds" parameterType="String">
        delete from xfpt_cart_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where c.del_flag = 0
    </sql>
</mapper>
