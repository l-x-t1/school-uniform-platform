<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptCommentMapper">

    <resultMap type="XfptComment" id="XfptCommentResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderItemId"    column="order_item_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="score"    column="score"    />
        <result property="content"    column="content"    />
        <result property="imagesJson"    column="images_json"    />
        <result property="replyContent"    column="reply_content"    />
        <result property="replyTime"    column="reply_time"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <resultMap id="XfptCommentXfptCommentReplyResult" type="XfptComment" extends="XfptCommentResult">
        <collection property="xfptCommentReplyList" ofType="XfptCommentReply" column="id" select="selectXfptCommentReplyList" />
    </resultMap>

    <resultMap type="XfptCommentReply" id="XfptCommentReplyResult">
        <result property="id"    column="id"    />
        <result property="commentId"    column="comment_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderItemId"    column="order_item_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="fromUserId"    column="from_user_id"    />
        <result property="fromUserName"    column="from_user_name"    />
        <result property="fromRoleType"    column="from_role_type"    />
        <result property="fromRoleTitle"    column="from_role_title"    />
        <result property="toUserId"    column="to_user_id"    />
        <result property="toUserName"    column="to_user_name"    />
        <result property="toRoleType"    column="to_role_type"    />
        <result property="toRoleTitle"    column="to_role_title"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptCommentVo">
        select id, order_id, order_item_id, order_no, goods_id, goods_name, user_id, user_name, supplier_id, score, content, images_json, reply_content, reply_time, status, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_comment
    </sql>

    <select id="selectXfptCommentList" parameterType="XfptComment" resultMap="XfptCommentResult">
        <include refid="selectXfptCommentVo"/>
        <include refid="search"/>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderItemId != null "> and order_item_id = #{orderItemId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no like concat('%', #{orderNo}, '%')</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="score != null "> and score = #{score}</if>
            <if test="replyTime != null "> and reply_time = #{replyTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>

    </select>

    <select id="selectXfptCommentById" parameterType="Long" resultMap="XfptCommentXfptCommentReplyResult">
        select id, order_id, order_item_id, order_no, goods_id, goods_name, user_id, user_name, supplier_id, score, content, images_json, reply_content, reply_time, status, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_comment
        where id = #{id}
    </select>

    <select id="selectXfptCommentReplyList" resultMap="XfptCommentReplyResult">
        select id, comment_id, order_id, order_item_id, goods_id, supplier_id, from_user_id, from_user_name, from_role_type, from_role_title, to_user_id, to_user_name, to_role_type, to_role_title, content, status, sort_num, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_comment_reply
        where comment_id = #{comment_id}
    </select>

    <insert id="insertXfptComment" parameterType="XfptComment" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="orderItemId != null">order_item_id,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="score != null">score,</if>
            <if test="content != null">content,</if>
            <if test="imagesJson != null">images_json,</if>
            <if test="replyContent != null">reply_content,</if>
            <if test="replyTime != null">reply_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="orderItemId != null">#{orderItemId},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="score != null">#{score},</if>
            <if test="content != null">#{content},</if>
            <if test="imagesJson != null">#{imagesJson},</if>
            <if test="replyContent != null">#{replyContent},</if>
            <if test="replyTime != null">#{replyTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptComment" parameterType="XfptComment">
        update xfpt_comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderItemId != null">order_item_id = #{orderItemId},</if>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="score != null">score = #{score},</if>
            <if test="content != null">content = #{content},</if>
            <if test="imagesJson != null">images_json = #{imagesJson},</if>
            <if test="replyContent != null">reply_content = #{replyContent},</if>
            <if test="replyTime != null">reply_time = #{replyTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptCommentById" parameterType="Long">
        delete from xfpt_comment where id = #{id}
    </delete>

    <delete id="deleteXfptCommentByIds" parameterType="String">
        delete from xfpt_comment where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteXfptCommentReplyByCommentIds" parameterType="String">
        delete from xfpt_comment_reply where comment_id in
        <foreach item="commentId" collection="array" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </delete>

    <delete id="deleteXfptCommentReplyByCommentId" parameterType="Long">
        delete from xfpt_comment_reply where comment_id = #{commentId}
    </delete>

    <insert id="batchXfptCommentReply">
        insert into xfpt_comment_reply( id, comment_id, order_id, order_item_id, goods_id, supplier_id, from_user_id, from_user_name, from_role_type, from_role_title, to_user_id, to_user_name, to_role_type, to_role_title, content, status, sort_num, create_by, create_time, update_by, update_time, remark, del_flag) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.commentId}, #{item.orderId}, #{item.orderItemId}, #{item.goodsId}, #{item.supplierId}, #{item.fromUserId}, #{item.fromUserName}, #{item.fromRoleType}, #{item.fromRoleTitle}, #{item.toUserId}, #{item.toUserName}, #{item.toRoleType}, #{item.toRoleTitle}, #{item.content}, #{item.status}, #{item.sortNum}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark}, #{item.delFlag})
        </foreach>
    </insert>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
