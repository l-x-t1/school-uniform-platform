<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptSchoolSupplierRelMapper">

    <resultMap type="XfptSchoolSupplierRel" id="XfptSchoolSupplierRelResult">
        <result property="id"    column="id"    />
        <result property="schoolId"    column="school_id"    />
        <result property="schoolName"    column="school_name"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="noticeId"    column="notice_id"    />
        <result property="contractId"    column="contract_id"    />
        <result property="cooperateStatus"    column="cooperate_status"    />
        <result property="servicePhone"    column="service_phone"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <resultMap id="XfptSchoolSupplierRelXfptSchoolSupplierGoodsRelResult" type="XfptSchoolSupplierRel" extends="XfptSchoolSupplierRelResult">
        <collection property="xfptSchoolSupplierGoodsRelList" ofType="XfptSchoolSupplierGoodsRel" column="id" select="selectXfptSchoolSupplierGoodsRelList" />
    </resultMap>

    <resultMap type="XfptSchoolSupplierGoodsRel" id="XfptSchoolSupplierGoodsRelResult">
        <result property="id"    column="id"    />
        <result property="relId"    column="rel_id"    />
        <result property="schoolId"    column="school_id"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="status"    column="status"    />
        <result property="schoolName"    column="school_name"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="goodsCode"    column="goods_code"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptSchoolSupplierRelVo">
        select id, school_id, school_name, supplier_id, supplier_name, notice_id, contract_id, cooperate_status, service_phone, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_school_supplier_rel
    </sql>

    <select id="selectXfptSchoolSupplierRelList" parameterType="XfptSchoolSupplierRel" resultMap="XfptSchoolSupplierRelResult">
        <include refid="selectXfptSchoolSupplierRelVo"/>
        <include refid="search"/>
            <if test="schoolId != null "> and school_id = #{schoolId}</if>
            <if test="schoolName != null  and schoolName != ''"> and school_name like concat('%', #{schoolName}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="noticeId != null "> and notice_id = #{noticeId}</if>
            <if test="contractId != null "> and contract_id = #{contractId}</if>
            <if test="cooperateStatus != null  and cooperateStatus != ''"> and cooperate_status = #{cooperateStatus}</if>
            <if test="servicePhone != null  and servicePhone != ''"> and service_phone like concat('%', #{servicePhone}, '%')</if>

    </select>

    <select id="selectXfptSchoolSupplierRelById" parameterType="Long" resultMap="XfptSchoolSupplierRelXfptSchoolSupplierGoodsRelResult">
        select id, school_id, school_name, supplier_id, supplier_name, notice_id, contract_id, cooperate_status, service_phone, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_school_supplier_rel
        where id = #{id}
    </select>

    <sql id="selectXfptSchoolSupplierGoodsRelVo">
        select gsr.id,
               gsr.rel_id,
               gsr.school_id,
               gsr.supplier_id,
               gsr.goods_id,
               gsr.status,
               coalesce(nullif(rel.school_name, ''), school.school_name) as school_name,
               coalesce(nullif(rel.supplier_name, ''), supplier.supplier_name) as supplier_name,
               goods.goods_name,
               goods.goods_code,
               gsr.create_by,
               gsr.create_time,
               gsr.update_by,
               gsr.update_time,
               gsr.remark,
               gsr.del_flag
        from xfpt_school_supplier_goods_rel gsr
        left join xfpt_school_supplier_rel rel
            on rel.id = gsr.rel_id
        left join xfpt_school_message school
            on school.id = gsr.school_id
        left join xfpt_supplier_message supplier
            on supplier.id = gsr.supplier_id
        left join xfpt_goods goods
            on goods.id = gsr.goods_id
    </sql>

    <select id="selectXfptSchoolSupplierGoodsRelList" resultMap="XfptSchoolSupplierGoodsRelResult">
        <include refid="selectXfptSchoolSupplierGoodsRelVo"/>
        where gsr.rel_id = #{id}
          and gsr.del_flag = '0'
    </select>

    <select id="selectXfptSchoolSupplierGoodsRelById" resultMap="XfptSchoolSupplierGoodsRelResult">
        <include refid="selectXfptSchoolSupplierGoodsRelVo"/>
        where gsr.rel_id = #{id}
          and gsr.del_flag = '0'
    </select>

    <insert id="insertXfptSchoolSupplierRel" parameterType="XfptSchoolSupplierRel" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_school_supplier_rel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="schoolId != null">school_id,</if>
            <if test="schoolName != null and schoolName != ''">school_name,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="noticeId != null">notice_id,</if>
            <if test="contractId != null">contract_id,</if>
            <if test="cooperateStatus != null and cooperateStatus != ''">cooperate_status,</if>
            <if test="servicePhone != null and servicePhone != ''">service_phone,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="schoolId != null">#{schoolId},</if>
            <if test="schoolName != null and schoolName != ''">#{schoolName},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="noticeId != null">#{noticeId},</if>
            <if test="contractId != null">#{contractId},</if>
            <if test="cooperateStatus != null and cooperateStatus != ''">#{cooperateStatus},</if>
            <if test="servicePhone != null and servicePhone != ''">#{servicePhone},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptSchoolSupplierRel" parameterType="XfptSchoolSupplierRel">
        update xfpt_school_supplier_rel
        <trim prefix="SET" suffixOverrides=",">
            <if test="schoolId != null">school_id = #{schoolId},</if>
            <if test="schoolName != null and schoolName != ''">school_name = #{schoolName},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="contractId != null">contract_id = #{contractId},</if>
            <if test="cooperateStatus != null and cooperateStatus != ''">cooperate_status = #{cooperateStatus},</if>
            <if test="servicePhone != null">service_phone = #{servicePhone},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptSchoolSupplierRelById" parameterType="Long">
        delete from xfpt_school_supplier_rel where id = #{id}
    </delete>

    <delete id="deleteXfptSchoolSupplierRelByIds" parameterType="String">
        delete from xfpt_school_supplier_rel where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteXfptSchoolSupplierGoodsRelByRelIds" parameterType="String">
        delete from xfpt_school_supplier_goods_rel where rel_id in
        <foreach item="relId" collection="array" open="(" separator="," close=")">
            #{relId}
        </foreach>
    </delete>

    <delete id="deleteXfptSchoolSupplierGoodsRelByRelId" parameterType="Long">
        delete from xfpt_school_supplier_goods_rel where rel_id = #{id}
    </delete>

    <insert id="batchInsertXfptSchoolSupplierGoodsRel">
        insert into xfpt_school_supplier_goods_rel( id, rel_id, school_id, supplier_id, goods_id, status, create_by, create_time, update_by, update_time, remark, del_flag) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.relId}, #{item.schoolId}, #{item.supplierId}, #{item.goodsId}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark}, #{item.delFlag})
        </foreach>
    </insert>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
