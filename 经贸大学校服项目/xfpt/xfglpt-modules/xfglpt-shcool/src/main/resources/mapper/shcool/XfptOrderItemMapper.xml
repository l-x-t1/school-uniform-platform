<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptOrderItemMapper">

    <resultMap type="XfptOrderItem" id="XfptOrderItemResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="sizeId"    column="size_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="sizeName"    column="size_name"    />
        <result property="mainImage"    column="main_image"    />
        <result property="saleType"    column="sale_type"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="buyNum"    column="buy_num"    />
        <result property="itemAmount"    column="item_amount"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptOrderItemVo">
        select oi.id, oi.order_id, o.order_no, oi.goods_id, oi.size_id, oi.goods_name, oi.size_name, oi.main_image, oi.sale_type, oi.unit_price, oi.buy_num, oi.item_amount, oi.dept_id, oi.create_by, oi.create_time, oi.update_by, oi.update_time, oi.remark, oi.del_flag
        from xfpt_order_item oi
        left join xfpt_order_info o on oi.order_id = o.id
    </sql>

    <select id="selectXfptOrderItemList" parameterType="XfptOrderItem" resultMap="XfptOrderItemResult">
        <include refid="selectXfptOrderItemVo"/>
        <include refid="search"/>
            <if test="orderId != null "> and oi.order_id = #{orderId}</if>
            <if test="orderNo != null and orderNo != ''"> and o.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="goodsId != null "> and oi.goods_id = #{goodsId}</if>
            <if test="sizeId != null "> and oi.size_id = #{sizeId}</if>
            <if test="goodsName != null  and goodsName != ''"> and oi.goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="sizeName != null  and sizeName != ''"> and oi.size_name like concat('%', #{sizeName}, '%')</if>
            <if test="mainImage != null  and mainImage != ''"> and oi.main_image = #{mainImage}</if>
            <if test="saleType != null  and saleType != ''"> and oi.sale_type = #{saleType}</if>
            <if test="unitPrice != null "> and oi.unit_price = #{unitPrice}</if>
            <if test="buyNum != null "> and oi.buy_num = #{buyNum}</if>
            <if test="itemAmount != null "> and oi.item_amount = #{itemAmount}</if>
            <if test="deptId != null "> and oi.dept_id = #{deptId}</if>

    </select>

    <select id="selectXfptOrderItemById" parameterType="Long" resultMap="XfptOrderItemResult">
        <include refid="selectXfptOrderItemVo"/>
        where oi.id = #{id}
    </select>

    <insert id="insertXfptOrderItem" parameterType="XfptOrderItem" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="sizeId != null">size_id,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="sizeName != null">size_name,</if>
            <if test="mainImage != null">main_image,</if>
            <if test="saleType != null and saleType != ''">sale_type,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="buyNum != null">buy_num,</if>
            <if test="itemAmount != null">item_amount,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sizeId != null">#{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="sizeName != null">#{sizeName},</if>
            <if test="mainImage != null">#{mainImage},</if>
            <if test="saleType != null and saleType != ''">#{saleType},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="buyNum != null">#{buyNum},</if>
            <if test="itemAmount != null">#{itemAmount},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptOrderItem" parameterType="XfptOrderItem">
        update xfpt_order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sizeId != null">size_id = #{sizeId},</if>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="sizeName != null">size_name = #{sizeName},</if>
            <if test="mainImage != null">main_image = #{mainImage},</if>
            <if test="saleType != null and saleType != ''">sale_type = #{saleType},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="buyNum != null">buy_num = #{buyNum},</if>
            <if test="itemAmount != null">item_amount = #{itemAmount},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptOrderItemById" parameterType="Long">
        delete from xfpt_order_item where id = #{id}
    </delete>

    <delete id="deleteXfptOrderItemByIds" parameterType="String">
        delete from xfpt_order_item where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where oi.del_flag = 0
    </sql>
</mapper>
