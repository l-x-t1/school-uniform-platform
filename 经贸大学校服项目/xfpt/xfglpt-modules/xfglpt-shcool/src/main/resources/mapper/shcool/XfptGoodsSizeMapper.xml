<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptGoodsSizeMapper">

    <resultMap type="XfptGoodsSize" id="XfptGoodsSizeResult">
        <result property="id"    column="id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="goodsCode"    column="goods_code"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="sizeCode"    column="size_code"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="genderType"    column="gender_type"    />
        <result property="measureJson"    column="measure_json"    />
        <result property="retailPrice"    column="retail_price"    />
        <result property="groupPrice"    column="group_price"    />
        <result property="stockNum"    column="stock_num"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptGoodsSizeVo">
        select gs.id, gs.goods_id, g.goods_name, g.goods_code, g.supplier_id, gs.size_code, gs.sort_num, gs.gender_type, gs.measure_json, gs.retail_price, gs.group_price, gs.stock_num, gs.status, gs.create_by, gs.create_time, gs.update_by, gs.update_time, gs.remark, gs.del_flag
        from xfpt_goods_size gs
        left join xfpt_goods g on gs.goods_id = g.id and g.del_flag = '0'
    </sql>

    <select id="selectXfptGoodsSizeList" parameterType="XfptGoodsSize" resultMap="XfptGoodsSizeResult">
        <include refid="selectXfptGoodsSizeVo"/>
        <include refid="search"/>
            <if test="supplierId != null "> and g.supplier_id = #{supplierId}</if>
            <if test="goodsId != null "> and gs.goods_id = #{goodsId}</if>
            <if test="sizeCode != null  and sizeCode != ''"> and gs.size_code like concat('%', #{sizeCode}, '%')</if>
            <if test="sortNum != null "> and gs.sort_num = #{sortNum}</if>
            <if test="genderType != null  and genderType != ''"> and gs.gender_type = #{genderType}</if>
            <if test="retailPrice != null "> and gs.retail_price = #{retailPrice}</if>
            <if test="groupPrice != null "> and gs.group_price = #{groupPrice}</if>
            <if test="stockNum != null "> and gs.stock_num = #{stockNum}</if>
            <if test="status != null  and status != ''"> and gs.status = #{status}</if>

    </select>

    <select id="selectXfptGoodsSizeById" parameterType="Long" resultMap="XfptGoodsSizeResult">
        <include refid="selectXfptGoodsSizeVo"/>
        where gs.id = #{id}
    </select>

    <insert id="insertXfptGoodsSize" parameterType="XfptGoodsSize" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_goods_size
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsId != null">goods_id,</if>
            <if test="sizeCode != null and sizeCode != ''">size_code,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="genderType != null">gender_type,</if>
            <if test="measureJson != null">measure_json,</if>
            <if test="retailPrice != null">retail_price,</if>
            <if test="groupPrice != null">group_price,</if>
            <if test="stockNum != null">stock_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsId != null">#{goodsId},</if>
            <if test="sizeCode != null and sizeCode != ''">#{sizeCode},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="genderType != null">#{genderType},</if>
            <if test="measureJson != null">#{measureJson},</if>
            <if test="retailPrice != null">#{retailPrice},</if>
            <if test="groupPrice != null">#{groupPrice},</if>
            <if test="stockNum != null">#{stockNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptGoodsSize" parameterType="XfptGoodsSize">
        update xfpt_goods_size
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="sizeCode != null and sizeCode != ''">size_code = #{sizeCode},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="genderType != null">gender_type = #{genderType},</if>
            <if test="measureJson != null">measure_json = #{measureJson},</if>
            <if test="retailPrice != null">retail_price = #{retailPrice},</if>
            <if test="groupPrice != null">group_price = #{groupPrice},</if>
            <if test="stockNum != null">stock_num = #{stockNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptGoodsSizeById" parameterType="Long">
        delete from xfpt_goods_size where id = #{id}
    </delete>

    <delete id="deleteXfptGoodsSizeByIds" parameterType="String">
        delete from xfpt_goods_size where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where gs.del_flag = 0
    </sql>
</mapper>
