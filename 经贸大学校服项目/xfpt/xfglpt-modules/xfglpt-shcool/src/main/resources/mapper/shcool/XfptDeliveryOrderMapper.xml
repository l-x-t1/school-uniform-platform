    <sql id="selectXfptDeliveryOrderVo">
        select id, delivery_no, notice_id, order_id, order_no, production_id, school_id, supplier_id, receiver_name, receiver_phone, receiver_address, logistics_company, logistics_no, delivery_status, delivery_time, sign_time, carriage_fee, dept_id, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_delivery_order
    </sql>

    <select id="selectXfptDeliveryOrderList" parameterType="XfptDeliveryOrder" resultMap="XfptDeliveryOrderResult">
        <include refid="selectXfptDeliveryOrderVo"/>
        <include refid="search"/>
            <if test="deliveryNo != null  and deliveryNo != ''"> and delivery_no like concat('%', #{deliveryNo}, '%')</if>
            <if test="noticeId != null "> and notice_id = #{noticeId}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no like concat('%', #{orderNo}, '%')</if>
            <if test="productionId != null "> and production_id = #{productionId}</if>
            <if test="schoolId != null "> and school_id = #{schoolId}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="receiverName != null  and receiverName != ''"> and receiver_name like concat('%', #{receiverName}, '%')</if>
            <if test="receiverPhone != null  and receiverPhone != ''"> and receiver_phone = #{receiverPhone}</if>
            <if test="receiverAddress != null  and receiverAddress != ''"> and receiver_address = #{receiverAddress}</if>
            <if test="logisticsCompany != null  and logisticsCompany != ''"> and logistics_company = #{logisticsCompany}</if>
            <if test="logisticsNo != null  and logisticsNo != ''"> and logistics_no like concat('%', #{logisticsNo}, '%')</if>
            <if test="deliveryStatus != null  and deliveryStatus != ''"> and delivery_status = #{deliveryStatus}</if>
            <if test="deliveryTime != null "> and delivery_time = #{deliveryTime}</if>
            <if test="signTime != null "> and sign_time = #{signTime}</if>
            <if test="carriageFee != null "> and carriage_fee = #{carriageFee}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>

    </select>

    <select id="selectXfptDeliveryOrderById" parameterType="Long" resultMap="XfptDeliveryOrderXfptDeliveryOrderItemResult">
        select id, delivery_no, notice_id, order_id, order_no, production_id, school_id, supplier_id, receiver_name, receiver_phone, receiver_address, logistics_company, logistics_no, delivery_status, delivery_time, sign_time, carriage_fee, dept_id, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_delivery_order
        where id = #{id}
    </select>

    <select id="selectXfptDeliveryOrderItemById" resultMap="XfptDeliveryOrderItemResult">
        select id, delivery_id, order_item_id, goods_id, size_id, goods_name, size_name, delivery_num, sign_num, status, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_delivery_order_item
        where delivery_id = #{id}
    </select>

    <insert id="insertXfptDeliveryOrder" parameterType="XfptDeliveryOrder" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_delivery_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryNo != null and deliveryNo != ''">delivery_no,</if>
            <if test="noticeId != null">notice_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="productionId != null">production_id,</if>
            <if test="schoolId != null">school_id,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="receiverName != null and receiverName != ''">receiver_name,</if>
            <if test="receiverPhone != null and receiverPhone != ''">receiver_phone,</if>
            <if test="receiverAddress != null and receiverAddress != ''">receiver_address,</if>
            <if test="logisticsCompany != null">logistics_company,</if>
            <if test="logisticsNo != null">logistics_no,</if>
            <if test="deliveryStatus != null and deliveryStatus != ''">delivery_status,</if>
            <if test="deliveryTime != null">delivery_time,</if>
            <if test="signTime != null">sign_time,</if>
            <if test="carriageFee != null">carriage_fee,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryNo != null and deliveryNo != ''">#{deliveryNo},</if>
            <if test="noticeId != null">#{noticeId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="productionId != null">#{productionId},</if>
            <if test="schoolId != null">#{schoolId},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="receiverName != null and receiverName != ''">#{receiverName},</if>
            <if test="receiverPhone != null and receiverPhone != ''">#{receiverPhone},</if>
            <if test="receiverAddress != null and receiverAddress != ''">#{receiverAddress},</if>
            <if test="logisticsCompany != null">#{logisticsCompany},</if>
            <if test="logisticsNo != null">#{logisticsNo},</if>
            <if test="deliveryStatus != null and deliveryStatus != ''">#{deliveryStatus},</if>
            <if test="deliveryTime != null">#{deliveryTime},</if>
            <if test="signTime != null">#{signTime},</if>
            <if test="carriageFee != null">#{carriageFee},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptDeliveryOrder" parameterType="XfptDeliveryOrder">
        update xfpt_delivery_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="deliveryNo != null and deliveryNo != ''">delivery_no = #{deliveryNo},</if>
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="productionId != null">production_id = #{productionId},</if>
            <if test="schoolId != null">school_id = #{schoolId},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null and receiverPhone != ''">receiver_phone = #{receiverPhone},</if>
            <if test="receiverAddress != null and receiverAddress != ''">receiver_address = #{receiverAddress},</if>
            <if test="logisticsCompany != null">logistics_company = #{logisticsCompany},</if>
            <if test="logisticsNo != null">logistics_no = #{logisticsNo},</if>
            <if test="deliveryStatus != null and deliveryStatus != ''">delivery_status = #{deliveryStatus},</if>
            <if test="deliveryTime != null">delivery_time = #{deliveryTime},</if>
            <if test="signTime != null">sign_time = #{signTime},</if>
            <if test="carriageFee != null">carriage_fee = #{carriageFee},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptDeliveryOrderById" parameterType="Long">
        delete from xfpt_delivery_order where id = #{id}
    </delete>

    <delete id="deleteXfptDeliveryOrderByIds" parameterType="String">
        delete from xfpt_delivery_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteXfptDeliveryOrderItemByDeliveryIds" parameterType="String">
        delete from xfpt_delivery_order_item where delivery_id in
        <foreach item="deliveryId" collection="array" open="(" separator="," close=")">
            #{deliveryId}
        </foreach>
    </delete>

    <delete id="deleteXfptDeliveryOrderItemByDeliveryId" parameterType="Long">
        delete from xfpt_delivery_order_item where delivery_id = #{id}
    </delete>

    <insert id="batchInsertXfptDeliveryOrderItem">
        insert into xfpt_delivery_order_item( id, delivery_id, order_item_id, goods_id, size_id, goods_name, size_name, delivery_num, sign_num, status, create_by, create_time, update_by, update_time, remark, del_flag) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.deliveryId}, #{item.orderItemId}, #{item.goodsId}, #{item.sizeId}, #{item.goodsName}, #{item.sizeName}, #{item.deliveryNum}, #{item.signNum}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark}, #{item.delFlag})
        </foreach>
    </insert>
    <sql id="search">
        where del_flag = 0
    </sql>
