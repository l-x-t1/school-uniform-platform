<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptSimUserMapper">

    <resultMap type="XfptSimUser" id="XfptSimUserResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="idCard"    column="id_card"    />
        <result property="parm1"    column="parm1"    />
        <result property="parm_2"    column="parm_2"    />
        <result property="parm_3"    column="parm_3"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
    </resultMap>

    <sql id="selectXfptSimUserVo">
        select id, name, id_card, parm1, parm_2, parm_3, create_time, update_by, update_time, del_flag, create_by from xfpt_sim_user
    </sql>

    <select id="selectXfptSimUserList" parameterType="XfptSimUser" resultMap="XfptSimUserResult">
        <include refid="selectXfptSimUserVo"/>
        <include refid="search"/>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="idCard != null  and idCard != ''"> and id_card = #{idCard}</if>
            <if test="parm1 != null  and parm1 != ''"> and parm1 = #{parm1}</if>
            <if test="parm2 != null  and parm2 != ''"> and parm_2 = #{parm2}</if>
            <if test="parm3 != null  and parm3 != ''"> and parm_3 = #{parm3}</if>

    </select>

    <select id="selectXfptSimUserById" parameterType="Long" resultMap="XfptSimUserResult">
        <include refid="selectXfptSimUserVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptSimUser" parameterType="XfptSimUser" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_sim_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="idCard != null">id_card,</if>
            <if test="parm1 != null">parm_1,</if>
            <if test="parm2 != null">parm_2,</if>
            <if test="parm3 != null">parm_3,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="parm1 != null">#{parm1},</if>
            <if test="parm2 != null">#{parm2},</if>
            <if test="parm3 != null">#{parm3},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
         </trim>
    </insert>

    <update id="updateXfptSimUser" parameterType="XfptSimUser">
        update xfpt_sim_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="parm1 != null">parm_1 = #{parm1},</if>
            <if test="parm2 != null">parm_2 = #{parm2},</if>
            <if test="parm3 != null">parm_3 = #{parm3},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptSimUserById" parameterType="Long">
        delete from xfpt_sim_user where id = #{id}
    </delete>

    <delete id="deleteXfptSimUserByIds" parameterType="String">
        delete from xfpt_sim_user where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
