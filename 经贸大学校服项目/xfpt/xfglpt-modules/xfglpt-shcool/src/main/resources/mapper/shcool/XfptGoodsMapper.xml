<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptGoodsMapper">

    <resultMap type="XfptGoods" id="XfptGoodsResult">
        <result property="id"    column="id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="goodsCode"    column="goods_code"    />
        <result property="categoryName"    column="category_name"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="brandName"    column="brand_name"    />
        <result property="mainImage"    column="main_image"    />
        <result property="detailImagesJson"    column="detail_images_json"    />
        <result property="detailContent"    column="detail_content"    />
        <result property="saleType"    column="sale_type"    />
        <result property="status"    column="status"    />
        <result property="publishStatus"    column="publish_status"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="offShelfTime"    column="off_shelf_time"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <resultMap id="XfptGoodsXfptGoodsSizeResult" type="XfptGoods" extends="XfptGoodsResult">
        <collection property="xfptGoodsSizeList" ofType="XfptGoodsSize" column="id" select="selectXfptGoodsSizeList" />
    </resultMap>

    <resultMap type="XfptGoodsSize" id="XfptGoodsSizeResult">
        <result property="id"    column="id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="sizeCode"    column="size_code"    />
        <result property="sortNum"    column="sort_num"    />
        <result property="genderType"    column="gender_type"    />
        <result property="measureJson"    column="measure_json"    />
        <result property="retailPrice"    column="retail_price"    />
        <result property="groupPrice"    column="group_price"    />
        <result property="stockNum"    column="stock_num"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptGoodsVo">
        select id, goods_name, goods_code, category_name, supplier_id, supplier_name, brand_name, main_image, detail_images_json, detail_content, sale_type, status, publish_status, publish_time, off_shelf_time, sort_num, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_goods
    </sql>

    <select id="selectXfptGoodsList" parameterType="XfptGoods" resultMap="XfptGoodsResult">
        <include refid="selectXfptGoodsVo"/>
        <include refid="search"/>
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="goodsCode != null  and goodsCode != ''"> and goods_code like concat('%', #{goodsCode}, '%')</if>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="brandName != null  and brandName != ''"> and brand_name like concat('%', #{brandName}, '%')</if>
            <if test="mainImage != null  and mainImage != ''"> and main_image = #{mainImage}</if>
            <if test="saleType != null  and saleType != ''"> and sale_type = #{saleType}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="publishStatus != null  and publishStatus != ''"> and publish_status = #{publishStatus}</if>
            <if test="publishTime != null ">
                and publish_time &gt;= #{publishTime}
                and publish_time &lt; date_add(#{publishTime}, interval 1 day)

            </if>
            <if test="offShelfTime != null ">
                and off_shelf_time &gt;= #{offShelfTime}
                and off_shelf_time &lt; date_add(#{offShelfTime}, interval 1 day)
            </if>
            <if test="sortNum != null "> and sort_num = #{sortNum}</if>

    </select>
<!--   转义字符 &gt;代表大于号 >  &lt;代表小于号 <   -->
    <select id="selectXfptGoodsById" parameterType="Long" resultMap="XfptGoodsXfptGoodsSizeResult">
        select id, goods_name, goods_code, category_name, supplier_id, supplier_name, brand_name, main_image, detail_images_json, detail_content, sale_type, status, publish_status, publish_time, off_shelf_time, sort_num, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_goods
        where id = #{id}
    </select>

    <select id="selectXfptGoodsSizeList" resultMap="XfptGoodsSizeResult">
        select id, goods_id, size_code, sort_num, gender_type, measure_json, retail_price, group_price, stock_num, status, create_by, create_time, update_by, update_time, remark, del_flag
        from xfpt_goods_size
        where goods_id = #{goods_id}
    </select>

    <insert id="insertXfptGoods" parameterType="XfptGoods" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="goodsCode != null and goodsCode != ''">goods_code,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="brandName != null">brand_name,</if>
            <if test="mainImage != null">main_image,</if>
            <if test="detailImagesJson != null">detail_images_json,</if>
            <if test="detailContent != null">detail_content,</if>
            <if test="saleType != null and saleType != ''">sale_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="publishStatus != null and publishStatus != ''">publish_status,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="offShelfTime != null">off_shelf_time,</if>
            <if test="sortNum != null">sort_num,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="goodsCode != null and goodsCode != ''">#{goodsCode},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="brandName != null">#{brandName},</if>
            <if test="mainImage != null">#{mainImage},</if>
            <if test="detailImagesJson != null">#{detailImagesJson},</if>
            <if test="detailContent != null">#{detailContent},</if>
            <if test="saleType != null and saleType != ''">#{saleType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="publishStatus != null and publishStatus != ''">#{publishStatus},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="offShelfTime != null">#{offShelfTime},</if>
            <if test="sortNum != null">#{sortNum},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptGoods" parameterType="XfptGoods">
        update xfpt_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="goodsCode != null and goodsCode != ''">goods_code = #{goodsCode},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="brandName != null">brand_name = #{brandName},</if>
            <if test="mainImage != null">main_image = #{mainImage},</if>
            <if test="detailImagesJson != null">detail_images_json = #{detailImagesJson},</if>
            <if test="detailContent != null">detail_content = #{detailContent},</if>
            <if test="saleType != null and saleType != ''">sale_type = #{saleType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="publishStatus != null and publishStatus != ''">publish_status = #{publishStatus},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="offShelfTime != null">off_shelf_time = #{offShelfTime},</if>
            <if test="sortNum != null">sort_num = #{sortNum},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptGoodsById" parameterType="Long">
        delete from xfpt_goods where id = #{id}
    </delete>

    <delete id="deleteXfptGoodsByIds" parameterType="String">
        delete from xfpt_goods where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteXfptGoodsSizeByGoodsIds" parameterType="String">
        delete from xfpt_goods_size where goods_id in
        <foreach item="goodsId" collection="array" open="(" separator="," close=")">
            #{goodsId}
        </foreach>
    </delete>

    <delete id="deleteXfptGoodsSizeByGoodsId" parameterType="Long">
        delete from xfpt_goods_size where goods_id = #{goodsId}
    </delete>

    <insert id="batchInsertXfptGoodsSize">
        insert into xfpt_goods_size( id, goods_id, size_code, sort_num, gender_type, measure_json, retail_price, group_price, stock_num, status, create_by, create_time, update_by, update_time, remark, del_flag) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.goodsId}, #{item.sizeCode}, #{item.sortNum}, #{item.genderType}, #{item.measureJson}, #{item.retailPrice}, #{item.groupPrice}, #{item.stockNum}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark}, #{item.delFlag})
        </foreach>
    </insert>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
