<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptSupplierApplyMapper">

    <resultMap type="XfptSupplierApply" id="XfptSupplierApplyResult">
        <result property="id"    column="id"    />
        <result property="noticeId"    column="notice_id"    />
        <result property="schoolId"    column="school_id"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="applyNo"    column="apply_no"    />
        <result property="applyStatus"    column="apply_status"    />
        <result property="qualificationStatus"    column="qualification_status"    />
        <result property="bidStageStatus"    column="bid_stage_status"    />
        <result property="bidResultStatus"    column="bid_result_status"    />
        <result property="applyTime"    column="apply_time"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="auditRemark"    column="audit_remark"    />
        <result property="applyFilesJson"    column="apply_files_json"    />
        <result property="compareFilesJson"    column="compare_files_json"    />
        <result property="deptId"    column="dept_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptSupplierApplyVo">
        select id, notice_id, school_id, supplier_id, supplier_name, apply_no, apply_status, qualification_status, bid_stage_status, bid_result_status, apply_time, audit_time, audit_remark, apply_files_json, compare_files_json, dept_id, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_supplier_apply
    </sql>

    <select id="selectXfptSupplierApplyList" parameterType="XfptSupplierApply" resultMap="XfptSupplierApplyResult">
        <include refid="selectXfptSupplierApplyVo"/>
        <include refid="search"/>
            <if test="noticeId != null "> and notice_id = #{noticeId}</if>
            <if test="schoolId != null "> and school_id = #{schoolId}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="applyNo != null  and applyNo != ''"> and apply_no like concat('%', #{applyNo}, '%')</if>
            <if test="applyStatus != null  and applyStatus != ''"> and apply_status = #{applyStatus}</if>
            <if test="qualificationStatus != null  and qualificationStatus != ''"> and qualification_status = #{qualificationStatus}</if>
            <if test="bidStageStatus != null  and bidStageStatus != ''"> and bid_stage_status = #{bidStageStatus}</if>
            <if test="bidResultStatus != null  and bidResultStatus != ''"> and bid_result_status = #{bidResultStatus}</if>
            <if test="applyTime != null "> and apply_time = #{applyTime}</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
            <if test="auditRemark != null  and auditRemark != ''"> and audit_remark = #{auditRemark}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>

    </select>

    <select id="selectXfptSupplierApplyById" parameterType="Long" resultMap="XfptSupplierApplyResult">
        <include refid="selectXfptSupplierApplyVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptSupplierApply" parameterType="XfptSupplierApply" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_supplier_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="noticeId != null">notice_id,</if>
            <if test="schoolId != null">school_id,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="applyNo != null and applyNo != ''">apply_no,</if>
            <if test="applyStatus != null and applyStatus != ''">apply_status,</if>
            <if test="qualificationStatus != null and qualificationStatus != ''">qualification_status,</if>
            <if test="bidStageStatus != null">bid_stage_status,</if>
            <if test="bidResultStatus != null">bid_result_status,</if>
            <if test="applyTime != null">apply_time,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="applyFilesJson != null">apply_files_json,</if>
            <if test="compareFilesJson != null">compare_files_json,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="noticeId != null">#{noticeId},</if>
            <if test="schoolId != null">#{schoolId},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="applyNo != null and applyNo != ''">#{applyNo},</if>
            <if test="applyStatus != null and applyStatus != ''">#{applyStatus},</if>
            <if test="qualificationStatus != null and qualificationStatus != ''">#{qualificationStatus},</if>
            <if test="bidStageStatus != null">#{bidStageStatus},</if>
            <if test="bidResultStatus != null">#{bidResultStatus},</if>
            <if test="applyTime != null">#{applyTime},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="applyFilesJson != null">#{applyFilesJson},</if>
            <if test="compareFilesJson != null">#{compareFilesJson},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptSupplierApply" parameterType="XfptSupplierApply">
        update xfpt_supplier_apply
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeId != null">notice_id = #{noticeId},</if>
            <if test="schoolId != null">school_id = #{schoolId},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="applyNo != null and applyNo != ''">apply_no = #{applyNo},</if>
            <if test="applyStatus != null and applyStatus != ''">apply_status = #{applyStatus},</if>
            <if test="qualificationStatus != null and qualificationStatus != ''">qualification_status = #{qualificationStatus},</if>
            <if test="bidStageStatus != null">bid_stage_status = #{bidStageStatus},</if>
            <if test="bidResultStatus != null">bid_result_status = #{bidResultStatus},</if>
            <if test="applyTime != null">apply_time = #{applyTime},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="applyFilesJson != null">apply_files_json = #{applyFilesJson},</if>
            <if test="compareFilesJson != null">compare_files_json = #{compareFilesJson},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptSupplierApplyById" parameterType="Long">
        delete from xfpt_supplier_apply where id = #{id}
    </delete>

    <delete id="deleteXfptSupplierApplyByIds" parameterType="String">
        delete from xfpt_supplier_apply where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
