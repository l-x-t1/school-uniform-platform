    </insert>

    <update id="updateXfptParentsFeedback" parameterType="XfptParentsFeedback">
        update xfpt_parents_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="feedbackContent != null">feedback_content = #{feedbackContent},</if>
            <if test="feedbackUrl != null">feedback_url = #{feedbackUrl},</if>
            <if test="replyContent != null">reply_content = #{replyContent},</if>
            <if test="replyUrl != null">reply_url = #{replyUrl},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="replyState != null">reply_state = #{replyState},</if>
