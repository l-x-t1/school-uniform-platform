    <delete id="deleteXfptParentsFeedbackByIds" parameterType="String">
        delete from xfpt_parents_feedback where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
