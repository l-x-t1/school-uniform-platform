            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="feedbackContent != null">feedback_content,</if>
            <if test="feedbackUrl != null">feedback_url,</if>
            <if test="replyContent != null">reply_content,</if>
            <if test="replyUrl != null">reply_url,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="replyState != null">reply_state,</if>
            <if test="replyBy != null">reply_by,</if>
            <if test="replyTime != null">reply_time,</if>

         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
