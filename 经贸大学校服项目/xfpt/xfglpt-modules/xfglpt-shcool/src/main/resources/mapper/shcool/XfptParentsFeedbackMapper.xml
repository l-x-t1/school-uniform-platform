<mapper namespace="com.xfgl.school.mapper.XfptParentsFeedbackMapper">

    <resultMap type="XfptParentsFeedback" id="XfptParentsFeedbackResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="deptId"    column="dept_id"    />
        <result property="deptName"    column="dept_name"    />
        <result property="feedbackContent"    column="feedback_content"    />
        <result property="feedbackUrl"    column="feedback_url"    />
        <result property="replyContent"    column="reply_content"    />
        <result property="replyUrl"    column="reply_url"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="replyState"    column="reply_state"    />
        <result property="replyBy"    column="reply_by"    />
        <result property="replyTime"    column="reply_time"    />
        <result property="isPublic"    column="is_public"    />
        <result property="lxfs"    column="lxfs"    />
        <result property="region"    column="region"    />
    </resultMap>

    <sql id="selectXfptParentsFeedbackVo">
        select back.*
        from xfpt_parents_feedback back left join SYS_DEPT dept
        ON back.dept_id=dept.dept_id
    </sql>

    <select id="selectXfptParentsFeedbackList" parameterType="XfptParentsFeedback" resultMap="XfptParentsFeedbackResult">
        <include refid="selectXfptParentsFeedbackVo"/>
        <where>
            back.del_flag = 0
            <if test="userId != null  and userId != ''"> and back.user_id = #{userId}</if>
            <if test="region != null  and region != ''"> and back.region = #{region}</if>
            <if test="userName != null  and userName != ''"> and back.user_name like concat('%', #{userName}, '%')</if>
            <if test="deptId != null  and deptId != ''"> and (dept.dept_id = #{deptId} or find_in_set(#{deptId},dept.ancestors))</if>
            <if test="deptName != null  and deptName != ''"> and back.dept_name like concat('%', #{deptName}, '%')</if>
            <if test="feedbackContent != null  and feedbackContent != ''"> and back.feedback_content = #{feedbackContent}</if>
            <if test="feedbackUrl != null  and feedbackUrl != ''"> and back.feedback_url = #{feedbackUrl}</if>
            <if test="replyContent != null  and replyContent != ''"> and back.reply_content = #{replyContent}</if>
            <if test="replyUrl != null  and replyUrl != ''"> and back.reply_url = #{replyUrl}</if>
        <if test="replyState != null  and replyState != ''"> and back.reply_state = #{replyState}</if>
        <if test="replyBy != null  and replyBy != ''"> and back.reply_by = #{replyBy}</if>
        <if test="replyTime != null  and replyBy != ''"> and back.reply_time = #{replyTime}</if>
        </where> order by create_time desc
    </select>

    <select id="selectXfptParentsFeedbackById" parameterType="Long" resultMap="XfptParentsFeedbackResult">
        <include refid="selectXfptParentsFeedbackVo"/>
        where id = #{id}
    </select>
    <select id="selectXfptParentsFeedbackList2" resultType="com.xfgl.school.domain.XfptParentsFeedback">
        <include refid="selectXfptParentsFeedbackVo"/>
        <where>
            back.del_flag = 0
            <if test="userId != null  and userId != ''"> and back.user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and back.user_name like concat('%', #{userName}, '%')</if>
            <if test="deptId != null  and deptId != ''"> and (dept.dept_id = #{deptId} or find_in_set(#{deptId},dept.ancestors) or dept.dept_id is null)</if>
            <if test="deptName != null  and deptName != ''"> and back.dept_name like concat('%', #{deptName}, '%')</if>
            <if test="feedbackContent != null  and feedbackContent != ''"> and back.feedback_content = #{feedbackContent}</if>
            <if test="feedbackUrl != null  and feedbackUrl != ''"> and back.feedback_url = #{feedbackUrl}</if>
            <if test="replyContent != null  and replyContent != ''"> and back.reply_content = #{replyContent}</if>
            <if test="replyUrl != null  and replyUrl != ''"> and back.reply_url = #{replyUrl}</if>
            <if test="replyState != null  and replyState != ''"> and back.reply_state = #{replyState}</if>
            <if test="replyBy != null  and replyBy != ''"> and back.reply_by = #{replyBy}</if>
            <if test="replyTime != null  and replyBy != ''"> and back.reply_time = #{replyTime}</if>
            <if test="region != null  and region != ''"> and back.region = #{region}</if>
        </where>order by create_time desc
    </select>

    <insert id="insertXfptParentsFeedback" parameterType="XfptParentsFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_parents_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
