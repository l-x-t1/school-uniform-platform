<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptSuppliceInspectionReportMapper">
    <resultMap type="XfptSuppliceInspectionReport" id="XfptSuppliceInspectionReportResult">
        <result property="id" column="id"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="supplierPhone" column="supplier_phone"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="teamMeetingId" column="team_meeting_id"/>
        <result property="ancestors" column="ancestors"/>
        <result property="noticeName" column="notice_name"/>
        <result property="manufacturerName" column="manufacturer_name"/>
        <result property="firstInspection" column="first_inspection"/>
        <result property="secondInspection" column="second_inspection"/>
        <result property="noticeStatus" column="notice_status"/>
        
    </resultMap>

    <sql id="selectXfptSuppliceInspectionReportVo">
        select r.id,
               r.dept_id,
               r.dept_name,
               r.supplier_id,
               r.supplier_name,
               r.supplier_phone,
               r.create_by,
               r.create_time,
               r.update_by,
               r.update_time,
               r.remark,
               r.team_meeting_id,
               r.ancestors,
               ar.notice_title as notice_name,
               coalesce(ar.transaction_company_name, r.supplier_name) as manufacturer_name,
               case when coalesce(ins.first_count, 0) > 0 then '1' else '' end as first_inspection,
               case when coalesce(ins.second_count, 0) > 0 then '1' else '' end as second_inspection,
               ar.is_release as notice_status
        from xfpt_supplice_inspection_report r
        left join (
            select latest.team_id,
                   latest.notice_title,
                   latest.transaction_company_name,
                   latest.is_release
            from (
                select ar.team_id,
                       ar.notice_title,
                       ar.transaction_company_name,
                       ar.is_release,
                       row_number() over (partition by ar.team_id order by ar.create_time desc, ar.id desc) as rn
                from xfpt_anno_results ar
                where ar.del_flag = 0
            ) latest
            where latest.rn = 1
        ) ar on ar.team_id = r.team_meeting_id
        left join (
            select report_id,
                   sum(case when type = '1' then 1 else 0 end) as first_count,
                   sum(case when type = '2' then 1 else 0 end) as second_count
            from xfpt_supplice_inspection_report_son
            where del_flag = 0
            group by report_id
        ) ins on ins.report_id = r.id
    </sql>

    <select id="selectXfptSuppliceInspectionReportList" parameterType="XfptSuppliceInspectionReport"
            resultMap="XfptSuppliceInspectionReportResult">
        <include refid="selectXfptSuppliceInspectionReportVo"/>
        <include refid="search"/>
        <if test="deptId != null  and deptId != ''">
            and r.dept_id = #{deptId}
        </if>
        <if test="deptName != null  and deptName != ''">
            and r.dept_name like concat('%', #{deptName}, '%')
        </if>
        <if test="supplierId != null  and supplierId != ''">
            and r.supplier_id = #{supplierId}
        </if>
        <if test="supplierName != null  and supplierName != ''">
            and r.supplier_name like concat('%', #{supplierName}, '%')
        </if>
        <if test="manufacturerName != null  and manufacturerName != ''">
            and coalesce(ar.transaction_company_name, r.supplier_name) like concat('%', #{manufacturerName}, '%')
        </if>
        <if test="noticeName != null  and noticeName != ''">
            and ar.notice_title like concat('%', #{noticeName}, '%')
        </if>
        <if test="supplierPhone != null  and supplierPhone != ''">
            and r.supplier_phone = #{supplierPhone}
        </if>
        <if test="teamMeetingId != null  and teamMeetingId != ''">
            and r.team_meeting_id = #{teamMeetingId}
        </if>
        
        <if test="ancestors != null  and ancestors != ''">
            and r.ancestors like concat('%', #{ancestors}, '%')
        </if>
        <if test="firstInspection != null  and firstInspection != ''">
            and case when coalesce(ins.first_count, 0) > 0 then '1' else '0' end = #{firstInspection}
        </if>
        <if test="secondInspection != null  and secondInspection != ''">
            and case when coalesce(ins.second_count, 0) > 0 then '1' else '0' end = #{secondInspection}
        </if>
        <if test="noticeStatus != null  and noticeStatus != ''">
            and coalesce(ar.is_release, '0') = #{noticeStatus}
        </if>
        <if test="dateRange != null  and dateRange != ''">
            and date(r.create_time) &gt;= substring_index(#{dateRange}, ' - ', 1)
            and date(r.create_time) &lt;= substring_index(#{dateRange}, ' - ', -1)
        </if>
        order by r.create_time desc, r.id desc
    </select>

    <select id="selectXfptSuppliceInspectionReportById" parameterType="Long"
            resultMap="XfptSuppliceInspectionReportResult">
        <include refid="selectXfptSuppliceInspectionReportVo"/>
        where r.id = #{id}
    </select>

    <insert id="insertXfptSuppliceInspectionReport" parameterType="XfptSuppliceInspectionReport" useGeneratedKeys="true"
            keyProperty="id">
        insert into xfpt_supplice_inspection_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">
                dept_id,
            </if>
            <if test="deptName != null">
                dept_name,
            </if>
            <if test="supplierId != null">
                supplier_id,
            </if>
            <if test="supplierName != null">
                supplier_name,
            </if>
            <if test="supplierPhone != null">
                supplier_phone,
            </if>
            <if test="createBy != null">
                create_by,
            </if>
            <if test="createTime != null">
                create_time,
            </if>
            <if test="updateBy != null">
                update_by,
            </if>
            <if test="updateTime != null">
                update_time,
            </if>
            <if test="remark != null">
                remark,
            </if>
            <if test="teamMeetingId != null">
                team_meeting_id,
            </if>
            <if test="ancestors != null">
                ancestors,
            </if>
            
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">
                #{deptId},
            </if>
            <if test="deptName != null">
                #{deptName},
            </if>
            <if test="supplierId != null">
                #{supplierId},
            </if>
            <if test="supplierName != null">
                #{supplierName},
            </if>
            <if test="supplierPhone != null">
                #{supplierPhone},
            </if>
            <if test="createBy != null">
                #{createBy},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="updateBy != null">
                #{updateBy},
            </if>
            <if test="updateTime != null">
                #{updateTime},
            </if>
            <if test="remark != null">
                #{remark},
            </if>
            <if test="teamMeetingId != null">
                #{teamMeetingId},
            </if>
            <if test="ancestors != null">
                #{ancestors},
            </if>
            
        </trim>
    </insert>

    <update id="updateXfptSuppliceInspectionReport" parameterType="XfptSuppliceInspectionReport">
        update xfpt_supplice_inspection_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">
                dept_id = #{deptId},
            </if>
            <if test="deptName != null">
                dept_name = #{deptName},
            </if>
            <if test="supplierId != null">
                supplier_id = #{supplierId},
            </if>
            <if test="supplierName != null">
                supplier_name = #{supplierName},
            </if>
            <if test="supplierPhone != null">
                supplier_phone = #{supplierPhone},
            </if>
            <if test="createBy != null">
                create_by = #{createBy},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="remark != null">
                remark = #{remark},
            </if>
            <if test="teamMeetingId != null">
                team_meeting_id = #{teamMeetingId},
            </if>
            <if test="ancestors != null">
                ancestors = #{ancestors},
            </if>
            
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptSuppliceInspectionReportById" parameterType="Long">
        delete
        from xfpt_supplice_inspection_report
        where id = #{id}
    </delete>

    <delete id="deleteXfptSuppliceInspectionReportByIds" parameterType="String">
        delete from xfpt_supplice_inspection_report where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where r.del_flag = 0
    </sql>
</mapper>
