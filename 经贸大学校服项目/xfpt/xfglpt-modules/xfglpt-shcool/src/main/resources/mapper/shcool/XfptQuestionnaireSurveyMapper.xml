<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptQuestionnaireSurveyMapper">

    <resultMap type="com.xfgl.school.domain.XfptQuestionnaireSurvey" id="XfptQuestionnaireSurveyResult">
        <result property="id"    column="id"    />
        <result property="surveyContent"    column="survey_content"    />
        <result property="surveyResult"    column="survey_result"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="answeringMethod"    column="answering_method"    />
        <result property="questionConfigId" column="question_config_id"/>
        <result property="isRequired" column="is_required"/>
        <result property="sm" column="sm"/>
    </resultMap>

    <sql id="selectXfptQuestionnaireSurveyVo">
        select sm,is_required,answering_method,id, survey_content, survey_result, create_by, create_time, update_by, update_time, remark, del_flag, question_config_id from xfpt_questionnaire_survey
    </sql>

    <select id="selectXfptQuestionnaireSurveyList" parameterType="XfptQuestionnaireSurvey" resultMap="XfptQuestionnaireSurveyResult">
        <include refid="selectXfptQuestionnaireSurveyVo"/>
        <include refid="search"/>
            <if test="surveyContent != null  and surveyContent != ''"> and survey_content = #{surveyContent}</if>
            <if test="surveyResult != null  and surveyResult != ''"> and survey_result = #{surveyResult}</if>
            <if test="questionConfigId != null"> and question_config_id = #{questionConfigId}</if>
    </select>

    <select id="selectXfptQuestionnaireSurveyById" parameterType="Long" resultMap="XfptQuestionnaireSurveyResult">
        <include refid="selectXfptQuestionnaireSurveyVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptQuestionnaireSurvey" parameterType="XfptQuestionnaireSurvey" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_questionnaire_survey
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="surveyContent != null">survey_content,</if>
            <if test="surveyResult != null">survey_result,</if>
            <if test="questionConfigId != null">question_config_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="surveyContent != null">#{surveyContent},</if>
            <if test="surveyResult != null">#{surveyResult},</if>
            <if test="questionConfigId != null">#{questionConfigId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptQuestionnaireSurvey" parameterType="XfptQuestionnaireSurvey">
        update xfpt_questionnaire_survey
        <trim prefix="SET" suffixOverrides=",">
            <if test="surveyContent != null">survey_content = #{surveyContent},</if>
            <if test="surveyResult != null">survey_result = #{surveyResult},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptQuestionnaireSurveyById" parameterType="Long">
        delete from xfpt_questionnaire_survey where id = #{id}
    </delete>

    <delete id="deleteXfptQuestionnaireSurveyByIds" parameterType="String">
        delete from xfpt_questionnaire_survey where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
