    <sql id="selectXfptProcSummaryVo">
        select dj,team_id,buy_time,id, title, money, invite_file, win_bid_file, enterprise, count, school_uniform_file, school_name, dept_id, ancestors, remark, create_by, create_time, update_time, update_by from xfpt_proc_summary
    </sql>

    <select id="selectXfptProcSummaryList" parameterType="XfptProcSummary" resultMap="XfptProcSummaryResult">
        <include refid="selectXfptProcSummaryVo"/>
        <include refid="search"/>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="money != null  and money != ''"> and money = #{money}</if>
            <if test="inviteFile != null  and inviteFile != ''"> and invite_file = #{inviteFile}</if>
            <if test="winBidFile != null  and winBidFile != ''"> and win_bid_file = #{winBidFile}</if>
            <if test="enterprise != null  and enterprise != ''"> and enterprise = #{enterprise}</if>
            <if test="count != null  and count != ''"> and count = #{count}</if>
            <if test="schoolUniformFile != null  and schoolUniformFile != ''"> and school_uniform_file = #{schoolUniformFile}</if>
            <if test="schoolName != null  and schoolName != ''"> and school_name like concat('%', #{schoolName}, '%')</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="ancestors != null  and ancestors != ''"> and ancestors = #{ancestors}</if>

    </select>

    <select id="selectXfptProcSummaryById" parameterType="Long" resultMap="XfptProcSummaryResult">
        <include refid="selectXfptProcSummaryVo"/>
        where id = #{id}
    </select>
    <select id="statistics" resultType="com.xfgl.school.domain.XfptProcSummary">
        SELECT * FROM XFPT_PROC_SUMMARY proc LEFT JOIN SYS_DEPT dept ON proc.dept_id = dept.dept_id
       <where>
           <if test="deptId != null"> (proc.dept_id = #{deptId} OR find_in_set(#{deptId},proc.ancestors))</if>
           <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
               AND date_format(buy_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
           </if>
           <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
               AND date_format(buy_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
           </if>
           and dept.DEL_FLAG = '0'
       </where>

    </select>
    <select id="statisticsTypeInfo" resultType="com.xfgl.school.domain.vo.OrderManagementStatisticsVo">
        SELECT
        dict.dict_label as district,
        dict.dict_value as schoolType,
        COALESCE(SUM(proc.count), 0) AS schoolUniformCount,
        COALESCE(SUM(proc.money), 0) AS buyCount
        FROM
        SYS_DICT_DATA dict
        LEFT JOIN (
        SELECT sm.* FROM XFPT_SCHOOL_MESSAGE sm
        LEFT JOIN SYS_DEPT dept ON sm.dept_id=dept.dept_id
        WHERE find_in_set(#{deptId},dept.ancestors)
        ) msg ON dict.dict_value = msg.school_type
        LEFT JOIN (
        SELECT * FROM XFPT_PROC_SUMMARY
        WHERE find_in_set(#{deptId},ancestors)
        AND date_format(buy_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
        AND date_format(buy_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
        ) proc ON proc.dept_id = msg.dept_id
        WHERE dict_type = 'sc_sc_type'
        GROUP BY dict.dict_label, dict.dict_value
        ORDER BY buyCount desc;

    </select>
