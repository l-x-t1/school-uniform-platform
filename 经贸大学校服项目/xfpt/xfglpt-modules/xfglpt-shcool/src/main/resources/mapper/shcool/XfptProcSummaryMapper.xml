    <select id="statisticsInfo" resultType="com.xfgl.school.domain.vo.OrderManagementStatisticsVo">
        SELECT
        dept.dept_name AS district,
        COALESCE(SUM(proc.count), 0) AS schoolUniformCount,
        COALESCE(SUM(proc.money), 0) AS buyCount,
        COUNT(team.id) AS ggCount,
        dept.school_type
        FROM
        (SELECT sdept.*,COALESCE(message.school_type, 4) AS school_type FROM SYS_DEPT sdept
        LEFT JOIN XFPT_SCHOOL_MESSAGE message  ON message.dept_id = sdept.dept_id ) dept
        LEFT JOIN (SELECT * FROM XFPT_PROC_SUMMARY where del_flag = '0' AND
        date_format(buy_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
        AND date_format(buy_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d'))
        proc ON proc.dept_id = dept.dept_id
        LEFT JOIN XFPT_TEAM_MEETING team ON  proc.TEAM_ID = team.id
        <where>
            <if test="deptId != null">dept.parent_id = #{deptId}</if>
            <if test="schoolType != null and  schoolType !='' ">and dept.school_type=#{schoolType} </if>
            <if test="isBuy == '1' or isBuy== 1">and proc.money is NOT NULL </if>
            <if test="isBuy == '0' or isBuy== 0">and proc.money is NULL </if>
        </where>
        GROUP BY dept.dept_name,dept.school_type
        ORDER BY buyCount DESC;
    </select>


