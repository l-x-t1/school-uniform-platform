            <if test="money != null">money = #{money},</if>
            <if test="inviteFile != null">invite_file = #{inviteFile},</if>
            <if test="winBidFile != null">win_bid_file = #{winBidFile},</if>
            <if test="enterprise != null">enterprise = #{enterprise},</if>
            <if test="count != null">count = #{count},</if>
            <if test="schoolUniformFile != null">school_uniform_file = #{schoolUniformFile},</if>
            <if test="schoolName != null">school_name = #{schoolName},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
