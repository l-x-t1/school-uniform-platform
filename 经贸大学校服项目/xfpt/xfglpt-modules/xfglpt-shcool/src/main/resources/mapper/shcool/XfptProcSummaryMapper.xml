        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptProcSummaryById" parameterType="Long">
        delete from xfpt_proc_summary where id = #{id}
    </delete>

    <delete id="deleteXfptProcSummaryByIds" parameterType="String">
        delete from xfpt_proc_summary where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
