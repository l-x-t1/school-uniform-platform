    <update id="updateSupplierMessage" parameterType="com.xfgl.school.domain.SupplierMessage">
        update xfpt_supplier_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="supplierPhone != null">supplier_phone = #{supplierPhone},</if>
            <if test="supplierType != null">supplier_type = #{supplierType},</if>
            <if test="legalRepresentative != null">legal_representative = #{legalRepresentative},</if>
            <if test="turnoverTime != null">turnover_time = #{turnoverTime},</if>
            <if test="staffNumber != null">staff_number = #{staffNumber},</if>
            <if test="establishedTime != null">established_time = #{establishedTime},</if>
            <if test="supplierAddress != null">supplier_address = #{supplierAddress},</if>
            <if test="supplierIntroduce != null">supplier_introduce = #{supplierIntroduce},</if>
            <if test="equipmentConditions != null">equipment_conditions = #{equipmentConditions},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
