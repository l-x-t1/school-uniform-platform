            <if test="establishedTime != null">established_time,</if>
            <if test="supplierAddress != null">supplier_address,</if>
            <if test="supplierIntroduce != null">supplier_introduce,</if>
            <if test="equipmentConditions != null">equipment_conditions,</if>
            <if test="businessLicense != null">business_license,</if>
            <if test="registeredCapital != null">registered_capital,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="insuredNumber != null">insured_number,</if>
            <if test="blacklistStatus != null">blacklist_status,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="xypj != null">xypj,</if>


