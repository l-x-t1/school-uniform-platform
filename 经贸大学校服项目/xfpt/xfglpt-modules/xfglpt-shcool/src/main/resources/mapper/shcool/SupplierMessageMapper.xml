            <if test="establishedTime != null">#{establishedTime},</if>
            <if test="supplierAddress != null">#{supplierAddress},</if>
            <if test="supplierIntroduce != null">#{supplierIntroduce},</if>
            <if test="equipmentConditions != null">#{equipmentConditions},</if>
            <if test="businessLicense != null">#{businessLicense},</if>
            <if test="registeredCapital != null">#{registeredCapital},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
