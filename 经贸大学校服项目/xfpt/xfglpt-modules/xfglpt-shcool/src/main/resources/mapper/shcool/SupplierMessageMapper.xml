    <sql id="selectSupplierMessageVo">
        select violation_reason,id, supplier_name, supplier_phone, supplier_type, legal_representative, turnover_time, staff_number, established_time, supplier_address, supplier_introduce, equipment_conditions, business_license, create_by, create_time, update_by, update_time, remark,registered_capital,insured_number,blacklist_status,dept_id,dept_name,ancestors,xypj from xfpt_supplier_message
    </sql>

    <select id="selectSupplierMessageList" parameterType="com.xfgl.school.domain.SupplierMessage" resultMap="SupplierMessageResult">
        <include refid="selectSupplierMessageVo"/>
        <include refid="search"/>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="supplierPhone != null  and supplierPhone != ''"> and supplier_phone = #{supplierPhone}</if>
            <if test="supplierType != null  and supplierType != ''"> and supplier_type = #{supplierType}</if>
            <if test="legalRepresentative != null  and legalRepresentative != ''"> and legal_representative = #{legalRepresentative}</if>
            <if test="turnoverTime != null "> and turnover_time = #{turnoverTime}</if>
            <if test="staffNumber != null  and staffNumber != ''"> and staff_number = #{staffNumber}</if>
            <if test="establishedTime != null "> and established_time = #{establishedTime}</if>
            <if test="supplierAddress != null  and supplierAddress != ''"> and supplier_address = #{supplierAddress}</if>
            <if test="supplierIntroduce != null  and supplierIntroduce != ''"> and supplier_introduce = #{supplierIntroduce}</if>
            <if test="equipmentConditions != null  and equipmentConditions != ''"> and equipment_conditions = #{equipmentConditions}</if>
            <if test="businessLicense != null  and businessLicense != ''"> and business_license = #{businessLicense}</if>
            <if test="insuredNumber != null  and insuredNumber != ''"> and insured_number = #{insuredNumber}</if>
            <if test="blacklistStatus != null  and blacklistStatus != ''"> and blacklist_status = #{blacklistStatus}</if>
        <if test="deptId != null  and deptId != ''"> and dept_id = #{deptId}</if>
        <if test="deptName != null  and deptName != ''"> and dept_name = #{deptName}</if>
        <if test="ancestors != null  and ancestors != ''"> and ancestors = #{ancestors}</if>
        order by create_time desc
    </select>

    <select id="selectSupplierMessageById" parameterType="Long" resultMap="SupplierMessageResult">
        <include refid="selectSupplierMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertSupplierMessage" parameterType="com.xfgl.school.domain.SupplierMessage" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_supplier_message
