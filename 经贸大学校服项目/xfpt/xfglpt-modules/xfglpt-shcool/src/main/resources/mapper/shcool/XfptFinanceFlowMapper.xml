    <sql id="selectXfptFinanceFlowVo">
        select f.id, f.flow_no, f.business_type, f.flow_direction, f.order_id, f.order_no, f.order_type, f.after_sale_id, a.after_sale_no, f.school_id, o.school_name, f.supplier_id, o.supplier_name, f.user_id, o.user_name, f.amount, f.pay_channel, f.trade_no, f.payee_type, f.payee_id, f.payee_name, f.payee_account_name, f.payee_bank_name, f.payee_bank_account_no, f.receipt_qr_code, f.status, f.trade_time, f.dept_id, f.create_by, f.create_time, f.update_by, f.update_time, f.remark, f.del_flag
        from xfpt_finance_flow f
        left join xfpt_order_info o on f.order_id = o.id
        left join xfpt_after_sale a on f.after_sale_id = a.id
    </sql>

    <select id="selectXfptFinanceFlowList" parameterType="XfptFinanceFlow" resultMap="XfptFinanceFlowResult">
