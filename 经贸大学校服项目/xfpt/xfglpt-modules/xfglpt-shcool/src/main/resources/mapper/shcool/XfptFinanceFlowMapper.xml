            <if test="flowNo != null  and flowNo != ''"> and f.flow_no like concat('%', #{flowNo}, '%')</if>
            <if test="businessType != null  and businessType != ''"> and f.business_type = #{businessType}</if>
            <if test="flowDirection != null  and flowDirection != ''"> and f.flow_direction = #{flowDirection}</if>
            <if test="orderId != null "> and f.order_id = #{orderId}</if>
            <if test="orderNo != null  and orderNo != ''"> and f.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="orderType != null  and orderType != ''"> and f.order_type = #{orderType}</if>
            <if test="afterSaleId != null "> and f.after_sale_id = #{afterSaleId}</if>
            <if test="schoolId != null "> and f.school_id = #{schoolId}</if>
            <if test="schoolName != null and schoolName != ''"> and o.school_name like concat('%', #{schoolName}, '%')</if>
            <if test="supplierId != null "> and f.supplier_id = #{supplierId}</if>
            <if test="supplierName != null and supplierName != ''"> and o.supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="userId != null "> and f.user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and o.user_name like concat('%', #{userName}, '%')</if>
            <if test="amount != null "> and f.amount = #{amount}</if>
            <if test="payChannel != null  and payChannel != ''"> and f.pay_channel = #{payChannel}</if>
            <if test="tradeNo != null  and tradeNo != ''"> and f.trade_no like concat('%', #{tradeNo}, '%')</if>
            <if test="payeeType != null  and payeeType != ''"> and f.payee_type = #{payeeType}</if>
            <if test="payeeId != null "> and f.payee_id = #{payeeId}</if>
            <if test="payeeName != null  and payeeName != ''"> and f.payee_name like concat('%', #{payeeName}, '%')</if>
            <if test="payeeAccountName != null  and payeeAccountName != ''"> and f.payee_account_name like concat('%', #{payeeAccountName}, '%')</if>
            <if test="payeeBankName != null  and payeeBankName != ''"> and f.payee_bank_name like concat('%', #{payeeBankName}, '%')</if>
            <if test="status != null  and status != ''"> and f.status = #{status}</if>
            <if test="tradeTime != null ">
                and f.trade_time &gt;= #{tradeTime}
                and f.trade_time &lt; date_add(#{tradeTime}, interval 1 day)
            </if>
            <if test="deptId != null "> and f.dept_id = #{deptId}</if>

    </select>

    <select id="selectXfptFinanceFlowById" parameterType="Long" resultMap="XfptFinanceFlowResult">
        <include refid="selectXfptFinanceFlowVo"/>
        where f.id = #{id}
    </select>

