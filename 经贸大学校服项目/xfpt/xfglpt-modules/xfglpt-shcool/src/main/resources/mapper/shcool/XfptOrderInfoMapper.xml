    <delete id="deleteXfptOrderInfoByIds" parameterType="String">
        delete from xfpt_order_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteXfptOrderItemByOrderIds" parameterType="String">
        delete from xfpt_order_item where order_id in
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

    <delete id="deleteXfptOrderItemByOrderId" parameterType="Long">
        delete from xfpt_order_item where order_id = #{id}
    </delete>

    <insert id="batchInsertXfptOrderItem">
