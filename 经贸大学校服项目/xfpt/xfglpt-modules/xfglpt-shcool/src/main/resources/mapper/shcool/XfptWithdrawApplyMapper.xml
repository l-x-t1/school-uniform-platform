<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptWithdrawApplyMapper">

    <resultMap type="XfptWithdrawApply" id="XfptWithdrawApplyResult">
        <result property="id"    column="id"    />
        <result property="withdrawNo"    column="withdraw_no"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="applyAmount"    column="apply_amount"    />
        <result property="bankInfoJson"    column="bank_info_json"    />
        <result property="status"    column="status"    />
        <result property="applyTime"    column="apply_time"    />
        <result property="auditUserId"    column="audit_user_id"    />
        <result property="auditUserName"    column="audit_user_name"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="payTime"    column="pay_time"    />
        <result property="auditRemark"    column="audit_remark"    />
        <result property="financeFlowId"    column="finance_flow_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptWithdrawApplyVo">
        select id, withdraw_no, supplier_id, supplier_name, apply_amount, bank_info_json, status, apply_time, audit_user_id, audit_user_name, audit_time, pay_time, audit_remark, finance_flow_id, create_by, create_time, update_by, update_time, remark, del_flag from xfpt_withdraw_apply
    </sql>

    <select id="selectXfptWithdrawApplyList" parameterType="XfptWithdrawApply" resultMap="XfptWithdrawApplyResult">
        <include refid="selectXfptWithdrawApplyVo"/>
        <include refid="search"/>
            <if test="withdrawNo != null  and withdrawNo != ''"> and withdraw_no like concat('%', #{withdrawNo}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="applyAmount != null "> and apply_amount = #{applyAmount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="applyTime != null "> and apply_time = #{applyTime}</if>
            <if test="params != null and params.beginTime != null and params.beginTime != ''">
                and apply_time &gt;= str_to_date(#{params.beginTime}, '%Y-%m-%d')
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''">
                and apply_time &lt; date_add(str_to_date(#{params.endTime}, '%Y-%m-%d'), interval 1 day)
            </if>
            <if test="auditUserId != null "> and audit_user_id = #{auditUserId}</if>
            <if test="auditUserName != null  and auditUserName != ''"> and audit_user_name like concat('%', #{auditUserName}, '%')</if>
            <if test="auditTime != null "> and audit_time = #{auditTime}</if>
            <if test="payTime != null "> and pay_time = #{payTime}</if>
            <if test="auditRemark != null  and auditRemark != ''"> and audit_remark = #{auditRemark}</if>
            <if test="financeFlowId != null "> and finance_flow_id = #{financeFlowId}</if>
        order by apply_time desc, id desc

    </select>

    <select id="selectSettlementManageList" parameterType="XfptWithdrawApply" resultMap="XfptWithdrawApplyResult">
        <include refid="selectXfptWithdrawApplyVo"/>
        <include refid="search"/>
            <if test="withdrawNo != null  and withdrawNo != ''"> and withdraw_no like concat('%', #{withdrawNo}, '%')</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and supplier_name like concat('%', #{supplierName}, '%')</if>
            <choose>
                <when test="status != null  and status != ''"> and status = #{status}</when>
                <otherwise> and status in ('1', '3')</otherwise>
            </choose>
            <if test="params != null and params.beginTime != null and params.beginTime != ''">
                and apply_time &gt;= str_to_date(#{params.beginTime}, '%Y-%m-%d')
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''">
                and apply_time &lt; date_add(str_to_date(#{params.endTime}, '%Y-%m-%d'), interval 1 day)
            </if>
        order by apply_time desc, id desc

    </select>

    <select id="selectXfptWithdrawApplyById" parameterType="Long" resultMap="XfptWithdrawApplyResult">
        <include refid="selectXfptWithdrawApplyVo"/>
        where id = #{id}
    </select>

    <insert id="insertXfptWithdrawApply" parameterType="XfptWithdrawApply" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_withdraw_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">withdraw_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null">supplier_name,</if>
            <if test="applyAmount != null">apply_amount,</if>
            <if test="bankInfoJson != null">bank_info_json,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="applyTime != null">apply_time,</if>
            <if test="auditUserId != null">audit_user_id,</if>
            <if test="auditUserName != null">audit_user_name,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="financeFlowId != null">finance_flow_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">#{withdrawNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null">#{supplierName},</if>
            <if test="applyAmount != null">#{applyAmount},</if>
            <if test="bankInfoJson != null">#{bankInfoJson},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="applyTime != null">#{applyTime},</if>
            <if test="auditUserId != null">#{auditUserId},</if>
            <if test="auditUserName != null">#{auditUserName},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="financeFlowId != null">#{financeFlowId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptWithdrawApply" parameterType="XfptWithdrawApply">
        update xfpt_withdraw_apply
        <trim prefix="SET" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">withdraw_no = #{withdrawNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="applyAmount != null">apply_amount = #{applyAmount},</if>
            <if test="bankInfoJson != null">bank_info_json = #{bankInfoJson},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="applyTime != null">apply_time = #{applyTime},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditUserName != null">audit_user_name = #{auditUserName},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="financeFlowId != null">finance_flow_id = #{financeFlowId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptWithdrawApplyById" parameterType="Long">
        delete from xfpt_withdraw_apply where id = #{id}
    </delete>

    <delete id="deleteXfptWithdrawApplyByIds" parameterType="String">
        delete from xfpt_withdraw_apply where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where del_flag = 0
    </sql>
</mapper>
