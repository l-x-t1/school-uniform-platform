<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfgl.school.mapper.XfptWithdrawApplyMapper">

    <resultMap type="XfptWithdrawApply" id="XfptWithdrawApplyResult">
        <result property="id"    column="id"    />
        <result property="withdrawNo"    column="withdraw_no"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="applyAmount"    column="apply_amount"    />
        <result property="bankInfoJson"    column="bank_info_json"    />
        <result property="status"    column="status"    />
        <result property="applyTime"    column="apply_time"    />
        <result property="auditUserId"    column="audit_user_id"    />
        <result property="auditUserName"    column="audit_user_name"    />
        <result property="auditTime"    column="audit_time"    />
        <result property="payTime"    column="pay_time"    />
        <result property="auditRemark"    column="audit_remark"    />
        <result property="financeFlowId"    column="finance_flow_id"    />
        <result property="schoolId"    column="school_id"    />
        <result property="schoolName"    column="school_name"    />
        <result property="flowNo"    column="flow_no"    />
        <result property="orderNo"    column="order_no"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectXfptWithdrawApplyVo">
        select
            w.id,
            w.withdraw_no,
            w.supplier_id,
            w.supplier_name,
            w.apply_amount,
            w.bank_info_json,
            w.status,
            w.apply_time,
            w.audit_user_id,
            w.audit_user_name,
            w.audit_time,
            w.pay_time,
            w.audit_remark,
            w.finance_flow_id,
            f.school_id,
            coalesce(o.school_name, d.dept_name) as school_name,
            f.flow_no,
            coalesce(o.order_no, f.order_no) as order_no,
            w.create_by,
            w.create_time,
            w.update_by,
            w.update_time,
            w.remark,
            w.del_flag
        from xfpt_withdraw_apply w
        left join xfpt_finance_flow f on w.finance_flow_id = f.id and f.del_flag = 0
        left join xfpt_order_info o on f.order_id = o.id and o.del_flag = 0
        left join sys_dept d on f.school_id = d.dept_id and d.del_flag = 0
    </sql>

    <select id="selectXfptWithdrawApplyList" parameterType="XfptWithdrawApply" resultMap="XfptWithdrawApplyResult">
        <include refid="selectXfptWithdrawApplyVo"/>
        <include refid="search"/>
            <if test="id != null"> and w.id = #{id}</if>
            <if test="withdrawNo != null  and withdrawNo != ''"> and w.withdraw_no like concat('%', #{withdrawNo}, '%')</if>
            <if test="supplierId != null "> and w.supplier_id = #{supplierId}</if>
            <if test="supplierName != null  and supplierName != ''"> and w.supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="schoolId != null "> and f.school_id = #{schoolId}</if>
            <if test="schoolName != null  and schoolName != ''"> and coalesce(o.school_name, d.dept_name) like concat('%', #{schoolName}, '%')</if>
            <if test="flowNo != null  and flowNo != ''"> and f.flow_no like concat('%', #{flowNo}, '%')</if>
            <if test="orderNo != null  and orderNo != ''"> and coalesce(o.order_no, f.order_no) like concat('%', #{orderNo}, '%')</if>
            <if test="applyAmount != null "> and w.apply_amount = #{applyAmount}</if>
            <if test="status != null  and status != ''"> and w.status = #{status}</if>
            <if test="applyTime != null "> and w.apply_time = #{applyTime}</if>
            <if test="auditUserId != null "> and w.audit_user_id = #{auditUserId}</if>
            <if test="auditUserName != null  and auditUserName != ''"> and w.audit_user_name like concat('%', #{auditUserName}, '%')</if>
            <if test="auditTime != null "> and w.audit_time = #{auditTime}</if>
            <if test="payTime != null "> and w.pay_time = #{payTime}</if>
            <if test="auditRemark != null  and auditRemark != ''"> and w.audit_remark = #{auditRemark}</if>
            <if test="financeFlowId != null "> and w.finance_flow_id = #{financeFlowId}</if>
            <if test="scopeSchoolIds != null and scopeSchoolIds.size() > 0">
                and f.school_id in
                <foreach item="schoolIdItem" collection="scopeSchoolIds" open="(" separator="," close=")">
                    #{schoolIdItem}
                </foreach>
            </if>
            <if test='viewMode != null and viewMode == "school"'>
                and f.school_id = #{scopeSchoolId}
                and (
                    f.order_id is null
                    or not exists (
                        select 1
                        from xfpt_order_item oi_all
                        where oi_all.order_id = f.order_id
                          and oi_all.del_flag = 0
                    )
                    or exists (
                        select 1
                        from xfpt_order_item oi
                        inner join xfpt_school_supplier_goods_rel rel
                            on rel.school_id = f.school_id
                           and rel.supplier_id = w.supplier_id
                           and rel.goods_id = oi.goods_id
                           and rel.del_flag = 0
                        where oi.order_id = f.order_id
                          and oi.del_flag = 0
                    )
                )
            </if>

    </select>

    <select id="selectXfptWithdrawApplyDetail" parameterType="XfptWithdrawApply" resultMap="XfptWithdrawApplyResult">
        <include refid="selectXfptWithdrawApplyVo"/>
        <include refid="search"/>
            and w.id = #{id}
            <if test="scopeSchoolIds != null and scopeSchoolIds.size() > 0">
                and f.school_id in
                <foreach item="schoolIdItem" collection="scopeSchoolIds" open="(" separator="," close=")">
                    #{schoolIdItem}
                </foreach>
            </if>
            <if test='viewMode != null and viewMode == "school"'>
                and f.school_id = #{scopeSchoolId}
                and (
                    f.order_id is null
                    or not exists (
                        select 1
                        from xfpt_order_item oi_all
                        where oi_all.order_id = f.order_id
                          and oi_all.del_flag = 0
                    )
                    or exists (
                        select 1
                        from xfpt_order_item oi
                        inner join xfpt_school_supplier_goods_rel rel
                            on rel.school_id = f.school_id
                           and rel.supplier_id = w.supplier_id
                           and rel.goods_id = oi.goods_id
                           and rel.del_flag = 0
                        where oi.order_id = f.order_id
                          and oi.del_flag = 0
                    )
                )
            </if>
    </select>

    <insert id="insertXfptWithdrawApply" parameterType="XfptWithdrawApply" useGeneratedKeys="true" keyProperty="id">
        insert into xfpt_withdraw_apply
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">withdraw_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null">supplier_name,</if>
            <if test="applyAmount != null">apply_amount,</if>
            <if test="bankInfoJson != null">bank_info_json,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="applyTime != null">apply_time,</if>
            <if test="auditUserId != null">audit_user_id,</if>
            <if test="auditUserName != null">audit_user_name,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="financeFlowId != null">finance_flow_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">#{withdrawNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null">#{supplierName},</if>
            <if test="applyAmount != null">#{applyAmount},</if>
            <if test="bankInfoJson != null">#{bankInfoJson},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="applyTime != null">#{applyTime},</if>
            <if test="auditUserId != null">#{auditUserId},</if>
            <if test="auditUserName != null">#{auditUserName},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="financeFlowId != null">#{financeFlowId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateXfptWithdrawApply" parameterType="XfptWithdrawApply">
        update xfpt_withdraw_apply
        <trim prefix="SET" suffixOverrides=",">
            <if test="withdrawNo != null and withdrawNo != ''">withdraw_no = #{withdrawNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="applyAmount != null">apply_amount = #{applyAmount},</if>
            <if test="bankInfoJson != null">bank_info_json = #{bankInfoJson},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="applyTime != null">apply_time = #{applyTime},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditUserName != null">audit_user_name = #{auditUserName},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="financeFlowId != null">finance_flow_id = #{financeFlowId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteXfptWithdrawApplyById" parameterType="Long">
        delete from xfpt_withdraw_apply where id = #{id}
    </delete>

    <delete id="deleteXfptWithdrawApplyByIds" parameterType="String">
        delete from xfpt_withdraw_apply where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <sql id="search">
        where w.del_flag = 0
    </sql>
</mapper>
